+++ b/scripts/ingest/bulbapedia-availability-parser.mts
@@ -0,0 +1,110 @@
+/**
+ * Bulbapedia "List of moves by availability in Generation N" 표(wikitext) 해석.
+ *
+ * 표 형식 (2026-10 기준)
+ *   ! {{gameabbrev7|SM}}  ← 게임 열 머리글 (순서대로)
+ *   |-
+ *   | 1
+ *   | {{m|Pound}}
+ *   {{typetable|Normal}}
+ *   {{statustable|Physical}}
+ *   | 35            (PP)
+ *   | 40            (위력)
+ *   | 100%          (명중)
+ *   | {{yes}}       ← 게임 열마다 하나: {{yes}} = 사용 가능, {{no}}·빈칸 = 사용 불가
+ *   | {{yes}}<br><small>3.0.0+</small>   (업데이트로 다시 쓸 수 있게 된 기술도 사용 가능)
+ *
+ * Z기술처럼 물리·특수로 번호가 두 번 나오는 기술은 같은 이름이 두 행에 있다.
+ * 둘 중 하나라도 사용 가능이면 사용 가능으로 본다.
+ */
+
+/** 표의 게임 약칭 → version_group id */
+export const GAME_TO_VERSION_GROUP: Record<string, number> = {
+  SM: 15,
+  USUM: 16,
+  PE: 17,
+  LGPE: 17,
+  SwSh: 18,
+  SWSH: 18,
+  BDSP: 19,
+  LA: 20,
+  PLA: 20,
+  SV: 21,
+  ZA: 22,
+  LZA: 22,
+};
+
+export const AVAILABILITY_PAGES = [
+  { entityKey: 'availability:gen7', title: 'List of moves by availability in Generation VII' },
+  { entityKey: 'availability:gen8', title: 'List of moves by availability in Generation VIII' },
+  { entityKey: 'availability:gen9', title: 'List of moves by availability in Generation IX' },
+] as const;
+
+export type AvailabilityRow = {
+  moveNumber: number;
+  name: string;
+  /** version_group id → 사용 가능 여부 */
+  usable: Map<number, boolean>;
+};
+
+export type ParsedAvailability = {
+  versionGroups: number[];
+  rows: Map<number, AvailabilityRow>;
+};
+
+/** 머리글 칸 → 게임 약칭. {{gameabbrev7|SM}} → SM, 그 밖에는 마지막 | 뒤 글자 */
+const headerGame = (cell: string): string => {
+  const abbrev = cell.match(/\{\{gameabbrev\d*\|([^}|]+)/);
+  if (abbrev) return abbrev[1].trim();
+  const last = cell.split('|').at(-1) ?? '';
+  return last.replace(/\{\{[^}]*\}\}|'''|''|\[\[|\]\]/g, '').trim();
+};
+
+export const parseAvailabilityTable = (wikitext: string): ParsedAvailability => {
+  // 게임 열 머리글: Accuracy 머리글 바로 뒤에 이어지는 ! 줄들
+  const lines = wikitext.split('\n');
+  const accuracyLine = lines.findIndex((line) => line.startsWith('!') && /Accuracy/.test(line));
+  if (accuracyLine < 0) throw new Error('표 머리글에서 Accuracy 열을 찾지 못했습니다');
+  const games: string[] = [];
+  for (let i = accuracyLine + 1; i < lines.length && lines[i].startsWith('!'); i += 1) {
+    games.push(headerGame(lines[i].slice(1).trim()));
+  }
+  if (games.length === 0) throw new Error('게임 열 머리글이 없습니다');
+  const versionGroups = games.map((g) => {
+    const vg = GAME_TO_VERSION_GROUP[g];
+    if (vg == null) throw new Error(`알 수 없는 게임 열 머리글: ${g} (머리글: ${games.join(', ')})`);
+    return vg;
+  });
+
+  const rows = new Map<number, AvailabilityRow>();
+  const numberByName = new Map<string, number>();
+  for (const block of wikitext.split('\n|-')) {
+    const cells = block
+      .split('\n')
+      .filter((line) => line.startsWith('|') && !line.startsWith('|}') && !line.startsWith('|-'))
+      .map((line) => line.slice(1).trim());
+    const moveNumber = Number(cells[0]);
+    const name = cells[1]?.match(/^\{\{m\|([^}|]+)/)?.[1];
+    if (!Number.isInteger(moveNumber) || moveNumber <= 0 || !name) continue;
+
+    const gameCells = cells.slice(5);
+    if (gameCells.length !== versionGroups.length) {
+      throw new Error(
+        `${moveNumber} ${name}: 게임 칸 ${gameCells.length}개, 머리글 ${versionGroups.length}개`,
+      );
+    }
+    const usable = new Map<number, boolean>();
+    versionGroups.forEach((vg, i) => usable.set(vg, /^\{\{yes\}\}/i.test(gameCells[i])));
+
+    // 같은 이름이 다시 나오면(Z기술 물리·특수) 처음 번호에 합친다
+    const firstNumber = numberByName.get(name);
+    const existing = firstNumber == null ? undefined : rows.get(firstNumber);
+    if (existing) {
+      for (const [vg, ok] of usable) if (ok) existing.usable.set(vg, true);
+    } else {
+      rows.set(moveNumber, { moveNumber, name, usable });
+      numberByName.set(name, moveNumber);
+    }
+  }
+  return { versionGroups, rows };
+};
diff --git a/scripts/ingest/bulbapedia-move-parser.mts b/scripts/ingest/bulbapedia-move-parser.mts
new file mode 100644
index 0000000..bafe9d5
--- /dev/null
+++ b/scripts/ingest/bulbapedia-move-parser.mts
@@ -0,0 +1,320 @@
+/**
+ * Bulbapedia 기술 문서(wikitext) 해석. DB에 접근하지 않는 순수 함수만 둔다.
+ *
+ * - {{MoveInfobox}}: 현재 값과 {{tt|현재|과거 설명}} 툴팁
+ * - {{LegendsZAMove}}: ZA 수치
+ * - 툴팁 설명("65 in Generation I", "85 prior to Generation V; 90 prior to Champions" 등)을
+ *   버전 그룹별 값으로 푼다. 해석할 수 없는 표현은 null을 돌려준다(추측하지 않는다).
+ */
+
+// ─── 버전 그룹 ───────────────────────────────────────────────────
+
+export type VersionGroup = { id: number; generation: number; sort_order: number };
+
+export const VG_LGPE = 17;
+export const VG_LEGENDS_ARCEUS = 20;
+export const VG_SCARLET_VIOLET = 21;
+export const VG_LEGENDS_ZA = 22;
+export const VG_CHAMPIONS = 23;
+
+// version_move와 비교하는 본가 버전 그룹 (LA·ZA·Champions는 별도 테이블)
+export const isMainline = (vg: VersionGroup) =>
+  vg.id !== VG_LEGENDS_ARCEUS && vg.id !== VG_LEGENDS_ZA && vg.id !== VG_CHAMPIONS;
+
+const ROMAN: Record<string, number> = {
+  I: 1, II: 2, III: 3, IV: 4, V: 5, VI: 6, VII: 7, VIII: 8, IX: 9,
+};
+
+// ─── 템플릿 ──────────────────────────────────────────────────────
+
+/** `{{Name\n|key=value\n...\n}}` 의 파라미터. 값 안의 {{...}}는 그대로 둔다 */
+export const parseTemplate = (content: string, name: string): Map<string, string> | null => {
+  const start = content.indexOf(`{{${name}`);
+  if (start < 0) return null;
+
+  // 중첩된 {{ }}를 세어 템플릿 끝을 찾는다
+  let depth = 0;
+  let end = -1;
+  for (let i = start; i < content.length - 1; i += 1) {
+    if (content[i] === '{' && content[i + 1] === '{') {
+      depth += 1;
+      i += 1;
+    } else if (content[i] === '}' && content[i + 1] === '}') {
+      depth -= 1;
+      i += 1;
+      if (depth === 0) {
+        end = i - 1;
+        break;
+      }
+    }
+  }
+  if (end < 0) return null;
+
+  const body = content.slice(start + 2 + name.length, end);
+  const params = new Map<string, string>();
+  // 최상위 '|'로만 나눈다
+  let level = 0;
+  let current = '';
+  const parts: string[] = [];
+  for (let i = 0; i < body.length; i += 1) {
+    const two = body.slice(i, i + 2);
+    if (two === '{{' || two === '[[') {
+      level += 1;
+      current += two;
+      i += 1;
+    } else if (two === '}}' || two === ']]') {
+      level -= 1;
+      current += two;
+      i += 1;
+    } else if (body[i] === '|' && level === 0) {
+      parts.push(current);
+      current = '';
+    } else {
+      current += body[i];
+    }
+  }
+  parts.push(current);
+
+  for (const part of parts) {
+    const eq = part.indexOf('=');
+    if (eq < 0) continue;
+    params.set(part.slice(0, eq).trim(), part.slice(eq + 1).trim());
+  }
+  return params;
+};
+
+/** 값 정리: HTML 주석·엔티티 제거 */
+const clean = (raw: string): string =>
+  raw
+    .replace(/<!--[\s\S]*?-->/g, '')
+    .replace(/&mdash;/g, '—')
+    .replace(/&ndash;/g, '–')
+    .trim();
+
+export type FieldValue = { current: string; history: string | null };
+
+/** `{{tt|90|65 in Generation I}}` → { current: '90', history: '65 in Generation I' } */
+export const parseFieldValue = (raw: string | undefined): FieldValue | null => {
+  if (raw == null) return null;
+  const value = clean(raw);
+  const tt = value.match(/^\{\{tt\|([^|}]*)\|([\s\S]*)\}\}$/);
+  if (tt) return { current: tt[1].trim(), history: clean(tt[2]) };
+  // 각주형 툴팁(예: 80{{tt|*|설명}})은 과거 값이 아니므로 무시
+  return { current: value.replace(/\{\{tt\|\*\|[\s\S]*?\}\}/g, '').trim(), history: null };
+};
+
+/**
+ * 수치 문자열 → 숫자. 값이 없음을 뜻하는 표현(—, 빈 값)은 null.
+ * 해석할 수 없으면 undefined (비교하지 않는다).
+ */
+export const parseNumber = (value: string): number | null | undefined => {
+  const v = value.replace(/−/g, '-').trim();
+  if (v === '' || v === '—' || v === '-' || v === '--') return null;
+  const m = v.match(/^([+-]?\d+)%?$/);
+  return m ? Number(m[1]) : undefined;
+};
+
+// ─── 툴팁 설명 해석 ───────────────────────────────────────────────
+
+export type HistorySegment = {
+  value: number | null;
+  /** 이 값이 적용되는 버전 그룹 */
+  vgIds: number[];
+  /** "prior to Champions": 본가 전체의 기준값이 된다 */
+  priorToChampions: boolean;
+};
+
+const gen = (roman: string): number | undefined => ROMAN[roman.toUpperCase()];
+
+/** 범위 표현 하나 → 버전 그룹 목록. 모르는 표현이면 null */
+const parseScope = (scope: string, vgs: VersionGroup[]): { vgIds: number[]; priorToChampions: boolean } | null => {
+  const s = scope.trim().replace(/\s+/g, ' ').replace(/^(?!in |prior to )/, 'in ');
+  const ids = (pred: (vg: VersionGroup) => boolean) => vgs.filter(pred).map((vg) => vg.id);
+  let m: RegExpMatchArray | null;
+
+  if (/^prior to (Pokémon )?Champions$/i.test(s)) {
+    return { vgIds: ids((vg) => vg.id < VG_CHAMPIONS), priorToChampions: true };
+  }
+  if ((m = s.match(/^prior to Generation ([IVX]+)$/i))) {
+    const g = gen(m[1]);
+    return g ? { vgIds: ids((vg) => vg.generation < g), priorToChampions: false } : null;
+  }
+  if ((m = s.match(/^in Generations? ([IVX]+) ?(?:-|–|to) ?([IVX]+)$/i))) {
+    const a = gen(m[1]);
+    const b = gen(m[2]);
+    return a && b ? { vgIds: ids((vg) => vg.generation >= a && vg.generation <= b), priorToChampions: false } : null;
+  }
+  if ((m = s.match(/^in Generation ([IVX]+)$/i))) {
+    const g = gen(m[1]);
+    return g ? { vgIds: ids((vg) => vg.generation === g), priorToChampions: false } : null;
+  }
+  if (/^in (LGPE|Pokémon: Let's Go, Pikachu! and Let's Go, Eevee!)$/i.test(s)) {
+    return { vgIds: [VG_LGPE], priorToChampions: false };
+  }
+  if (/^prior to (LGPE|Pokémon: Let's Go, Pikachu! and Let's Go, Eevee!)$/i.test(s)) {
+    const lgpe = vgs.find((vg) => vg.id === VG_LGPE);
+    return lgpe ? { vgIds: ids((vg) => vg.sort_order < lgpe.sort_order), priorToChampions: false } : null;
+  }
+  if (/^in (Pokémon )?Legends: Arceus$|^in P:LA$/i.test(s)) {
+    return { vgIds: [VG_LEGENDS_ARCEUS], priorToChampions: false };
+  }
+  if (/^in Scarlet (and|&) Violet$/i.test(s)) {
+    return { vgIds: [VG_SCARLET_VIOLET], priorToChampions: false };
+  }
+  return null;
+};
+
+/**
+ * 툴팁 설명 전체 → 구간 목록. 한 구간이라도 해석하지 못하면 null.
+ * 예: "85 prior to Generation V; 90 prior to Pokémon Champions"
+ *     "70 in Generations I-IV, 80 in Generation V"
+ *     "65 prior to Generation IV and in Legends: Arceus"
+ */
+export const parseHistory = (note: string, vgs: VersionGroup[]): HistorySegment[] | null => {
+  const pieces = note
+    .replace(/−/g, '-')
+    // Bulbapedia 표기 흔들림: "10 in prior to Generation V"
+    .replace(/\bin prior to\b/gi, 'prior to')
+    .split(/;\s*|,\s*(?=[+-]?\d|—)/)
+    .map((p) => p.trim())
+    .filter(Boolean);
+  if (pieces.length === 0) return null;
+
+  const segments: HistorySegment[] = [];
+  for (const piece of pieces) {
+    const m = piece.match(/^([+-]?\d+%?|—)\s+(.+)$/);
+    if (!m) return null;
+    const value = parseNumber(m[1]);
+    if (value === undefined) return null;
+
+    const vgIds = new Set<number>();
+    let priorToChampions = false;
+    for (const scope of m[2].split(/\s+and\s+(?=in |prior to |LGPE|Legends|P:LA)/i)) {
+      const parsed = parseScope(scope, vgs);
+      if (!parsed) return null;
+      parsed.vgIds.forEach((id) => vgIds.add(id));
+      priorToChampions ||= parsed.priorToChampions;
+    }
+    segments.push({ value, vgIds: [...vgIds], priorToChampions });
+  }
+  return segments;
+};
+
+/**
+ * 버전 그룹별 기대값.
+ * - 기준값: "prior to Champions" 값이 있으면 그것, 없으면 현재 값
+ * - 나머지 구간은 넓은 구간부터 적용해서 좁은 구간이 이기게 한다
+ * 반환: vgId → 값, 그리고 그 값이 툴팁에 명시된 것인지(explicit)
+ */
+export const expectedByVersionGroup = (
+  current: number | null,
+  segments: HistorySegment[],
+  vgs: VersionGroup[],
+): Map<number, { value: number | null; explicit: boolean }> => {
+  const champions = segments.find((s) => s.priorToChampions);
+  const base = champions ? champions.value : current;
+  const result = new Map<number, { value: number | null; explicit: boolean }>();
+  for (const vg of vgs) result.set(vg.id, { value: base, explicit: false });
+
+  const others = segments
+    .filter((s) => !s.priorToChampions)
+    .sort((a, b) => b.vgIds.length - a.vgIds.length);
+  for (const s of others) {
+    for (const id of s.vgIds) result.set(id, { value: s.value, explicit: true });
+  }
+  return result;
+};
+
+// ─── 인포박스 ────────────────────────────────────────────────────
+
+export type ParsedMove = {
+  type: string | null;
+  category: string | null;
+  contact: boolean | null;
+  fields: {
+    power?: FieldValue;
+    accuracy?: FieldValue;
+    pp?: FieldValue;
+    priority?: FieldValue;
+  };
+};
+
+export const parseInfobox = (content: string): ParsedMove | null => {
+  const box = parseTemplate(content, 'MoveInfobox');
+  if (!box) return null;
+
+  const lower = (key: string) => {
+    const v = box.get(key);
+    return v ? clean(v).toLowerCase() || null : null;
+  };
+  const touches = lower('touches');
+
+  const fields: ParsedMove['fields'] = {};
+  const power = parseFieldValue(box.get('power'));
+  const accuracy = parseFieldValue(box.get('accuracy'));
+  const pp = parseFieldValue(box.get('basepp'));
+  const priority = parseFieldValue(box.get('priority'));
+  if (power) fields.power = power;
+  if (accuracy) fields.accuracy = accuracy;
+  if (pp) fields.pp = pp;
+  if (priority) fields.priority = priority;
+
+  return {
+    type: lower('type'),
+    category: lower('damagecategory'),
+    contact: touches === 'yes' ? true : touches === 'no' ? false : null,
+    fields,
+  };
+};
+
+// ─── ZA ──────────────────────────────────────────────────────────
+
+export type ParsedZa = {
+  type: string | null;
+  category: string | null;
+  base: { power?: number | null; cooldown?: number | null; windUp?: number | null; duration?: number | null };
+  plus: { power?: number | null; cooldown?: number | null; windUp?: number | null; duration?: number | null };
+};
+
+export const parseLegendsZa = (content: string): ParsedZa | null => {
+  const za = parseTemplate(content, 'LegendsZAMove');
+  if (!za) return null;
+
+  const num = (key: string) => {
+    const raw = za.get(key);
+    if (raw == null) return undefined;
+    const v = parseNumber(clean(raw));
+    return v === undefined ? undefined : v;
+  };
+  const pick = (entries: [string, number | null | undefined][]) =>
+    Object.fromEntries(entries.filter(([, v]) => v !== undefined));
+
+  return {
+    type: za.get('type') ? clean(za.get('type') ?? '').toLowerCase() : null,
+    category: za.get('damagecategory') ? clean(za.get('damagecategory') ?? '').toLowerCase() : null,
+    base: pick([
+      ['power', num('power')],
+      ['cooldown', num('cooldown')],
+      ['windUp', num('charge-time')],
+      ['duration', num('effect-duration')],
+    ]),
+    plus: pick([
+      ['power', num('power-plus')],
+      ['cooldown', num('cooldown-plus')],
+      ['windUp', num('charge-time-plus')],
+      ['duration', num('effect-duration-plus')],
+    ]),
+  };
+};
+
+// ─── 3세대 이전 분류 규칙 ─────────────────────────────────────────
+
+// 물리/특수 분리(4세대) 전에는 타입으로 분류가 정해진다
+const PHYSICAL_TYPES_BEFORE_GEN4 = new Set([
+  'normal', 'fighting', 'flying', 'poison', 'ground', 'rock', 'bug', 'ghost', 'steel',
+]);
+
+export const categoryBeforeGen4 = (typeIdentifier: string): 'physical' | 'special' | null => {
+  if (typeIdentifier === 'unknown') return null;
+  return PHYSICAL_TYPES_BEFORE_GEN4.has(typeIdentifier) ? 'physical' : 'special';
+};
diff --git a/scripts/ingest/fetch-availability-snapshot.mts b/scripts/ingest/fetch-availability-snapshot.mts
new file mode 100644
index 0000000..57f6a5e
--- /dev/null
+++ b/scripts/ingest/fetch-availability-snapshot.mts
@@ -0,0 +1,99 @@
+/**
+ * Bulbapedia "List of moves by availability in Generation VII·VIII·IX" 원문을 ingest.snapshot에 저장한다.
+ * 본편 버전별 사용 가능 여부(version_move.is_usable)의 기준 표다.
+ *
+ * - public 스키마는 읽기만 한다 (ingest_bot 권한).
+ * - 같은 내용은 다시 저장하지 않는다 (source, page_key, content_hash 유니크).
+ * - 요청·재시도 규칙은 fetch-move-snapshot.mts와 같다.
+ *
+ * 실행:
+ *   node --env-file=.env.local scripts/ingest/fetch-availability-snapshot.mts
+ */
+import postgres from 'postgres';
+
+import { AVAILABILITY_PAGES } from './bulbapedia-availability-parser.mts';
+import { fetchRevisions, hashContent, resolveTitle } from './fetch-move-snapshot.mts';
+
+const PROJECT_REF = 'gdveyihxwjemujyhpgzy';
+
+type RunStats = {
+  inserted: string[];
+  unchanged: string[];
+  missingPage: string[];
+  retries: number;
+};
+
+const requireEnv = (key: string): string => {
+  const value = process.env[key];
+  if (!value) throw new Error(`${key} 환경 변수가 없습니다 (.env.local 확인)`);
+  return value;
+};
+
+const main = async () => {
+  const sql = postgres({
+    host: requireEnv('INGEST_DB_HOST'),
+    port: 5432,
+    database: 'postgres',
+    username: `ingest_bot.${PROJECT_REF}`,
+    password: requireEnv('INGEST_DB_PASSWORD'),
+    ssl: 'require',
+    max: 1,
+    prepare: false,
+  });
+
+  const stats: RunStats = { inserted: [], unchanged: [], missingPage: [], retries: 0 };
+  const [run] = await sql<{ id: number }[]>`
+    insert into ingest.run (source, scope) values ('bulbapedia', 'availability:gen7-9') returning id
+  `;
+  const runId = run.id;
+
+  try {
+    const titles = AVAILABILITY_PAGES.map((p) => p.title);
+    const { query } = await fetchRevisions(titles, (reason, waitMs, attempt) => {
+      stats.retries += 1;
+      console.warn(`  ${reason} → ${Math.round(waitMs / 1000)}초 후 다시 시도 (${attempt})`);
+    });
+    if (!query?.pages) throw new Error('Bulbapedia API 응답에 pages가 없습니다');
+    const pageByTitle = new Map(query.pages.map((page) => [page.title, page]));
+
+    for (const { entityKey, title } of AVAILABILITY_PAGES) {
+      const resolved = resolveTitle(title, query);
+      const revision = pageByTitle.get(resolved)?.revisions?.[0];
+      if (!revision) {
+        stats.missingPage.push(title);
+        continue;
+      }
+      const content = revision.slots.main.content;
+      const inserted = await sql`
+        insert into ingest.snapshot (run_id, source, page_key, entity_key, rev_id, content, content_hash)
+        values (${runId}, 'bulbapedia', ${resolved}, ${entityKey}, ${revision.revid}, ${content},
+                ${hashContent(content)})
+        on conflict (source, page_key, content_hash) do nothing
+        returning id
+      `;
+      (inserted.length > 0 ? stats.inserted : stats.unchanged).push(entityKey);
+    }
+
+    const status = stats.missingPage.length > 0 ? 'partial' : 'success';
+    await sql`
+      update ingest.run set status = ${status}, finished_at = now(), stats = ${sql.json(stats)}
+      where id = ${runId}
+    `;
+    console.log(`[run ${runId}] ${status}`, stats);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    await sql`
+      update ingest.run set status = 'failed', finished_at = now(), stats = ${sql.json(stats)},
+             error = ${message}
+      where id = ${runId}
+    `;
+    console.error(`[run ${runId}] failed: ${message}`);
+    process.exitCode = 1;
+  } finally {
+    await sql.end();
+  }
+};
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  await main();
+}
diff --git a/scripts/ingest/fetch-move-snapshot.mts b/scripts/ingest/fetch-move-snapshot.mts
new file mode 100644
index 0000000..7d32f43
--- /dev/null
+++ b/scripts/ingest/fetch-move-snapshot.mts
@@ -0,0 +1,396 @@
+/**
+ * Bulbapedia 기술 문서 원문(wikitext)을 ingest.snapshot에 저장한다.
+ *
+ * - public 스키마는 읽기만 한다. ingest_bot 역할에 public 쓰기 권한이 없어서
+ *   코드에 실수가 있어도 DB가 거부한다.
+ * - 같은 페이지의 같은 내용은 다시 저장하지 않는다 (source, page_key, content_hash 유니크).
+ * - 파싱·제안 생성은 하지 않는다. 원문 보관만 하는 1단계 스크립트.
+ * - Bulbapedia가 바쁘다고 응답하면(503 등) 기다렸다가 다시 시도한다.
+ *
+ * 실행 (기술 id 범위):
+ *   node --env-file=.env.local scripts/ingest/fetch-move-snapshot.mts 1 902
+ *   node --env-file=.env.local scripts/ingest/fetch-move-snapshot.mts 1 902 --missing-only
+ *     (--missing-only: 아직 원문이 하나도 없는 기술만 받는다. 중단된 수집을 이어받을 때)
+ *   node --env-file=.env.local scripts/ingest/fetch-move-snapshot.mts --changed-only
+ *     (--changed-only: 판 번호만 먼저 묻고, 저장된 최신 판과 다른 문서만 원문을 받는다.
+ *      매일 자동 수집용. id를 생략하면 전체 기술)
+ *
+ * 필요한 환경 변수 (.env.local):
+ *   INGEST_DB_HOST      Supabase Connect > Session pooler 의 host
+ *   INGEST_DB_PASSWORD  ingest_bot 비밀번호
+ */
+import { createHash } from 'node:crypto';
+import postgres from 'postgres';
+
+const PROJECT_REF = 'gdveyihxwjemujyhpgzy';
+// 테스트에서만 바꾼다
+const API_URL =
+  process.env.BULBAPEDIA_API_URL ?? 'https://bulbapedia.bulbagarden.net/w/api.php';
+const USER_AGENT =
+  'poke-mumu-ingest/0.1 (+https://github.com/jomoo02/poke-mumu)';
+
+// 한 요청에 받는 문서 수. 원문 전체를 받으므로 응답이 커지지 않게 작게 유지한다
+const BATCH_SIZE = 20;
+// 판 번호만 물을 때 한 요청에 넣는 문서 수 (MediaWiki titles 상한)
+const REV_ID_BATCH_SIZE = 50;
+// 요청 사이 대기 시간
+const REQUEST_INTERVAL_MS = 2000;
+
+// 서버가 바쁠 때 다시 시도하는 규칙
+const RETRYABLE_STATUS = new Set([429, 502, 503, 504]);
+const MAX_ATTEMPTS = 5;
+const BASE_BACKOFF_MS = 5000; // 5초, 10초, 20초, 40초
+const MAX_BACKOFF_MS = 60000;
+
+interface MoveRow {
+  id: number;
+  identifier: string;
+  name_en: string | null;
+}
+
+interface WikiRevision {
+  revid: number;
+  timestamp: string;
+  slots: { main: { content: string } };
+}
+
+interface WikiPage {
+  title: string;
+  missing?: boolean;
+  invalid?: boolean;
+  revisions?: WikiRevision[];
+}
+
+interface WikiTitleMapping {
+  from: string;
+  to: string;
+}
+
+interface WikiResponse {
+  query?: {
+    pages?: WikiPage[];
+    normalized?: WikiTitleMapping[];
+    redirects?: WikiTitleMapping[];
+  };
+  error?: { code: string; info: string };
+}
+
+// sql.json()에 넘기려면 인덱스 시그니처 호환이 필요해서 interface 대신 type으로 둔다
+type RunStats = {
+  requested: number;
+  skippedExisting: number;
+  skippedSameRevision: number;
+  inserted: number;
+  unchanged: number;
+  retries: number;
+  noEnglishName: string[];
+  missingPage: string[];
+  redirected: string[];
+};
+
+// DB 영어 이름은 둥근 따옴표(King’s Shield), Bulbapedia 문서 제목은 곧은 따옴표(King's Shield)
+export const toMoveTitle = (nameEn: string): string =>
+  `${nameEn.replace(/[‘’]/g, "'")} (move)`;
+
+/**
+ * 요청한 제목이 응답에서 어떤 실제 페이지로 이어졌는지 따라간다.
+ * 순서: 정규화(공백·대소문자) → 리다이렉트(옛 이름 → 현재 이름)
+ */
+export const resolveTitle = (
+  requested: string,
+  query: NonNullable<WikiResponse['query']>,
+): string => {
+  const normalized =
+    query.normalized?.find((m) => m.from === requested)?.to ?? requested;
+  return query.redirects?.find((m) => m.from === normalized)?.to ?? normalized;
+};
+
+export const hashContent = (content: string): string =>
+  createHash('sha256').update(content).digest('hex');
+
+const sleep = (ms: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+const requireEnv = (key: string): string => {
+  const value = process.env[key];
+  if (!value) {
+    throw new Error(`${key} 환경 변수가 없습니다 (.env.local 확인)`);
+  }
+  return value;
+};
+
+type Args = { from: number; to: number; missingOnly: boolean; changedOnly: boolean };
+
+const USAGE =
+  '사용법: fetch-move-snapshot.mts [<시작 id> [끝 id]] [--missing-only | --changed-only]\n' +
+  '  id를 생략하면 전체 기술';
+
+export const parseArgs = (args: string[]): Args => {
+  const missingOnly = args.includes('--missing-only');
+  const changedOnly = args.includes('--changed-only');
+  if (missingOnly && changedOnly) throw new Error(USAGE);
+
+  const positional = args.filter((a) => !a.startsWith('--'));
+  if (positional.length === 0) {
+    return { from: 1, to: Number.MAX_SAFE_INTEGER, missingOnly, changedOnly };
+  }
+  const [fromArg, toArg = fromArg] = positional;
+  const from = Number(fromArg);
+  const to = Number(toArg);
+  if (!Number.isInteger(from) || !Number.isInteger(to) || from < 1 || from > to) {
+    throw new Error(USAGE);
+  }
+  return { from, to, missingOnly, changedOnly };
+};
+
+const scopeLabel = ({ from, to, missingOnly, changedOnly }: Args): string => {
+  const range = to === Number.MAX_SAFE_INTEGER ? 'all' : `${from}-${to}`;
+  const mode = missingOnly ? ' missing-only' : changedOnly ? ' changed-only' : '';
+  return `move:${range}${mode}`;
+};
+
+/** 서버가 알려준 대기 시간(초). 없으면 null */
+const retryAfterMs = (res: Response): number | null => {
+  const seconds = Number(res.headers.get('retry-after'));
+  return Number.isFinite(seconds) && seconds > 0 ? seconds * 1000 : null;
+};
+
+type RetryHandler = (reason: string, waitMs: number, attempt: number) => void;
+
+export const fetchRevisions = (titles: string[], onRetry: RetryHandler): Promise<WikiResponse> =>
+  requestRevisions(titles, 'ids|timestamp|content', onRetry);
+
+/**
+ * 원문 없이 최신 판 번호만 받는다. 바뀐 문서만 원문을 받을 때 먼저 쓴다.
+ * 응답이 작아서 한 번에 50개까지 묻는다 (MediaWiki titles 상한).
+ */
+export const fetchLatestRevIds = async (
+  titles: string[],
+  onRetry: RetryHandler,
+): Promise<Map<string, number | null>> => {
+  const result = new Map<string, number | null>();
+  for (let i = 0; i < titles.length; i += REV_ID_BATCH_SIZE) {
+    if (i > 0) await sleep(REQUEST_INTERVAL_MS);
+    const batch = titles.slice(i, i + REV_ID_BATCH_SIZE);
+    const { query } = await requestRevisions(batch, 'ids', onRetry);
+    if (!query?.pages) {
+      throw new Error('Bulbapedia API 응답에 pages가 없습니다');
+    }
+    const pageByTitle = new Map(query.pages.map((page) => [page.title, page]));
+    for (const title of batch) {
+      const page = pageByTitle.get(resolveTitle(title, query));
+      result.set(title, page?.revisions?.[0]?.revid ?? null);
+    }
+  }
+  return result;
+};
+
+const requestRevisions = async (
+  titles: string[],
+  rvprop: 'ids' | 'ids|timestamp|content',
+  onRetry: RetryHandler,
+): Promise<WikiResponse> => {
+  const params = new URLSearchParams({
+    action: 'query',
+    prop: 'revisions',
+    rvprop,
+    redirects: '1',
+    format: 'json',
+    formatversion: '2',
+    // 서버가 바쁠 때(복제 지연 5초 초과) 요청을 거절받도록 한다
+    maxlag: '5',
+    titles: titles.join('|'),
+  });
+  if (rvprop !== 'ids') params.set('rvslots', 'main');
+
+  for (let attempt = 1; ; attempt += 1) {
+    const res = await fetch(`${API_URL}?${params}`, {
+      headers: { 'User-Agent': USER_AGENT },
+    });
+
+    let reason: string;
+    if (RETRYABLE_STATUS.has(res.status)) {
+      reason = `HTTP ${res.status}`;
+      await res.body?.cancel();
+    } else if (!res.ok) {
+      throw new Error(`Bulbapedia API ${res.status} ${res.statusText}`);
+    } else {
+      const body = (await res.json()) as WikiResponse;
+      if (body.error?.code === 'maxlag') {
+        reason = 'maxlag';
+      } else if (body.error) {
+        throw new Error(`Bulbapedia API ${body.error.code}: ${body.error.info}`);
+      } else {
+        return body;
+      }
+    }
+
+    if (attempt >= MAX_ATTEMPTS) {
+      throw new Error(`Bulbapedia API ${reason} (${attempt}회 시도 후 중단)`);
+    }
+    const waitMs = Math.min(
+      retryAfterMs(res) ?? BASE_BACKOFF_MS * 2 ** (attempt - 1),
+      MAX_BACKOFF_MS,
+    );
+    onRetry(reason, waitMs, attempt);
+    await sleep(waitMs);
+  }
+};
+
+const main = async () => {
+  const args = parseArgs(process.argv.slice(2));
+  const { from, to, missingOnly, changedOnly } = args;
+
+  const sql = postgres({
+    host: requireEnv('INGEST_DB_HOST'),
+    port: 5432,
+    database: 'postgres',
+    username: `ingest_bot.${PROJECT_REF}`,
+    password: requireEnv('INGEST_DB_PASSWORD'),
+    ssl: 'require',
+    max: 1,
+    prepare: false,
+  });
+
+  const stats: RunStats = {
+    requested: 0,
+    skippedExisting: 0,
+    skippedSameRevision: 0,
+    inserted: 0,
+    unchanged: 0,
+    retries: 0,
+    noEnglishName: [],
+    missingPage: [],
+    redirected: [],
+  };
+
+  const [run] = await sql<{ id: number }[]>`
+    insert into ingest.run (source, scope)
+    values ('bulbapedia', ${scopeLabel(args)})
+    returning id
+  `;
+  const runId = run.id;
+
+  const onRetry: RetryHandler = (reason, waitMs, attempt) => {
+    stats.retries += 1;
+    console.warn(
+      `  ${reason} → ${Math.round(waitMs / 1000)}초 후 다시 시도 (${attempt}/${MAX_ATTEMPTS - 1})`,
+    );
+  };
+
+  try {
+    // bigint는 문자열로 오므로 ::int로 받는다
+    const moves = await sql<(MoveRow & { latest_rev_id: number | null })[]>`
+      select m.id::int, m.identifier, m.name_en,
+             (select s.rev_id::int from ingest.snapshot s
+              where s.source = 'bulbapedia' and s.entity_key = 'move:' || m.id
+              order by s.fetched_at desc limit 1) as latest_rev_id
+      from public.move m
+      where m.id between ${from} and ${to}
+      order by m.id
+    `;
+    stats.requested = moves.length;
+
+    let targets = moves.filter((move) => {
+      if (missingOnly && move.latest_rev_id !== null) {
+        stats.skippedExisting += 1;
+        return false;
+      }
+      if (move.name_en) return true;
+      stats.noEnglishName.push(move.identifier);
+      return false;
+    });
+
+    // 판 번호가 저장된 최신 판과 같은 문서는 원문을 받지 않는다
+    if (changedOnly) {
+      const revIds = await fetchLatestRevIds(
+        targets.map((move) => toMoveTitle(move.name_en ?? '')),
+        onRetry,
+      );
+      targets = targets.filter((move) => {
+        const revId = revIds.get(toMoveTitle(move.name_en ?? ''));
+        if (revId !== null && revId !== undefined && revId === move.latest_rev_id) {
+          stats.skippedSameRevision += 1;
+          return false;
+        }
+        return true;
+      });
+      console.log(`  판 번호 확인: ${moves.length}개 중 바뀐 문서 ${targets.length}개`);
+    }
+
+    for (let i = 0; i < targets.length; i += BATCH_SIZE) {
+      if (i > 0) await sleep(REQUEST_INTERVAL_MS);
+
+      const batch = targets.slice(i, i + BATCH_SIZE);
+      const titles = batch.map((move) => toMoveTitle(move.name_en ?? ''));
+      const { query } = await fetchRevisions(titles, onRetry);
+      if (!query?.pages) {
+        throw new Error('Bulbapedia API 응답에 pages가 없습니다');
+      }
+
+      const pageByTitle = new Map(query.pages.map((page) => [page.title, page]));
+
+      for (const [index, move] of batch.entries()) {
+        const requested = titles[index];
+        const resolved = resolveTitle(requested, query);
+        const page = pageByTitle.get(resolved);
+        const revision = page?.revisions?.[0];
+
+        if (!page || page.missing || page.invalid || !revision) {
+          stats.missingPage.push(`${move.identifier} (${requested})`);
+          continue;
+        }
+        if (resolved !== requested) {
+          stats.redirected.push(`${requested} → ${resolved}`);
+        }
+
+        const content = revision.slots.main.content;
+        const inserted = await sql`
+          insert into ingest.snapshot
+            (run_id, source, page_key, entity_key, rev_id, content, content_hash)
+          values
+            (${runId}, 'bulbapedia', ${resolved}, ${`move:${move.id}`},
+             ${revision.revid}, ${content}, ${hashContent(content)})
+          on conflict (source, page_key, content_hash) do nothing
+          returning id
+        `;
+
+        if (inserted.length > 0) stats.inserted += 1;
+        else stats.unchanged += 1;
+      }
+
+      const done = Math.min(i + BATCH_SIZE, targets.length);
+      console.log(`  ${done}/${targets.length} (저장 ${stats.inserted}, 변경 없음 ${stats.unchanged})`);
+    }
+
+    const status =
+      stats.missingPage.length > 0 || stats.noEnglishName.length > 0
+        ? 'partial'
+        : 'success';
+
+    await sql`
+      update ingest.run
+      set status = ${status}, finished_at = now(), stats = ${sql.json(stats)}
+      where id = ${runId}
+    `;
+    console.log(`[run ${runId}] ${status}`, stats);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    await sql`
+      update ingest.run
+      set status = 'failed', finished_at = now(),
+          stats = ${sql.json(stats)}, error = ${message}
+      where id = ${runId}
+    `;
+    console.error(`[run ${runId}] failed: ${message}`);
+    console.error('  저장된 원문은 남아 있습니다. --missing-only로 이어받을 수 있어요');
+    process.exitCode = 1;
+  } finally {
+    await sql.end();
+  }
+};
+
+// 테스트에서 import할 때는 실행하지 않는다
+if (import.meta.url === `file://${process.argv[1]}`) {
+  await main();
+}
diff --git a/scripts/ingest/fetch-showdown-snapshot.mts b/scripts/ingest/fetch-showdown-snapshot.mts
new file mode 100644
index 0000000..3407d4e
--- /dev/null
+++ b/scripts/ingest/fetch-showdown-snapshot.mts
@@ -0,0 +1,182 @@
+/**
+ * Pokémon Showdown 저장소의 Champions 관련 데이터 파일 원문을 ingest.snapshot에 저장한다.
+ *
+ * - 모든 파일을 같은 커밋에서 받는다 (중간에 저장소가 바뀌어도 파일끼리 어긋나지 않게).
+ * - 받은 파일은 실행하지 않는다. 원문만 저장하고, 해석은 다음 단계 파서가 구문 트리로 한다.
+ * - 같은 파일의 같은 내용은 다시 저장하지 않는다 (source, page_key, content_hash 유니크).
+ * - public 스키마는 건드리지 않는다.
+ *
+ * 실행:
+ *   node --env-file=.env.local scripts/ingest/fetch-showdown-snapshot.mts
+ *   node scripts/ingest/fetch-showdown-snapshot.mts --dry-run   (DB 없이 받기만 확인)
+ */
+import { createHash } from 'node:crypto';
+import postgres from 'postgres';
+
+const PROJECT_REF = 'gdveyihxwjemujyhpgzy';
+const REPO = 'smogon/pokemon-showdown';
+const USER_AGENT =
+  'poke-mumu-ingest/0.1 (+https://github.com/jomoo02/poke-mumu)';
+const REQUEST_INTERVAL_MS = 300;
+
+// 무엇을 왜 받는지
+const FILES = [
+  // 전 기술 기본값과 isNonstandard(사용 가능 여부)
+  'data/moves.ts',
+  // Champions에서 바뀐 수치·사용 가능 여부 덮어쓰기
+  'data/mods/champions/moves.ts',
+  // Champions 배우는 기술
+  'data/mods/champions/learnsets.ts',
+  // PP 공식 등 Champions 전역 규칙 (공식이 바뀌면 감지하기 위해)
+  'data/mods/champions/scripts.ts',
+  // 폼 포켓몬 ID → poke_key 매핑에 필요한 baseSpecies·forme 정보
+  'data/pokedex.ts',
+] as const;
+
+type FileResult = {
+  path: string;
+  bytes: number;
+  hash: string;
+  status: 'inserted' | 'unchanged' | 'dry-run';
+};
+
+// sql.json()에 넘기려면 인덱스 시그니처 호환이 필요해서 interface 대신 type으로 둔다
+type RunStats = {
+  commit: string | null;
+  files: FileResult[];
+};
+
+export const hashContent = (content: string): string =>
+  createHash('sha256').update(content).digest('hex');
+
+const sleep = (ms: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+const requireEnv = (key: string): string => {
+  const value = process.env[key];
+  if (!value) {
+    throw new Error(`${key} 환경 변수가 없습니다 (.env.local 확인)`);
+  }
+  return value;
+};
+
+/** master의 최신 커밋 SHA. 실패하면 null을 돌려주고 master 기준으로 받는다 */
+const fetchLatestCommit = async (): Promise<string | null> => {
+  try {
+    const res = await fetch(
+      `https://api.github.com/repos/${REPO}/commits/master`,
+      {
+        headers: {
+          'User-Agent': USER_AGENT,
+          Accept: 'application/vnd.github.sha',
+        },
+      },
+    );
+    if (!res.ok) return null;
+    const sha = (await res.text()).trim();
+    return /^[0-9a-f]{40}$/.test(sha) ? sha : null;
+  } catch {
+    return null;
+  }
+};
+
+const fetchRawFile = async (ref: string, path: string): Promise<string> => {
+  const res = await fetch(
+    `https://raw.githubusercontent.com/${REPO}/${ref}/${path}`,
+    { headers: { 'User-Agent': USER_AGENT } },
+  );
+  if (!res.ok) {
+    throw new Error(`${path}: GitHub ${res.status} ${res.statusText}`);
+  }
+  return res.text();
+};
+
+const main = async () => {
+  const dryRun = process.argv.includes('--dry-run');
+  const commit = await fetchLatestCommit();
+  const ref = commit ?? 'master';
+  const stats: RunStats = { commit, files: [] };
+
+  if (dryRun) {
+    for (const [index, path] of FILES.entries()) {
+      if (index > 0) await sleep(REQUEST_INTERVAL_MS);
+      const content = await fetchRawFile(ref, path);
+      stats.files.push({
+        path,
+        bytes: content.length,
+        hash: hashContent(content).slice(0, 12),
+        status: 'dry-run',
+      });
+    }
+    console.log('[dry-run]', JSON.stringify(stats, null, 2));
+    return;
+  }
+
+  const sql = postgres({
+    host: requireEnv('INGEST_DB_HOST'),
+    port: 5432,
+    database: 'postgres',
+    username: `ingest_bot.${PROJECT_REF}`,
+    password: requireEnv('INGEST_DB_PASSWORD'),
+    ssl: 'require',
+    max: 1,
+    prepare: false,
+  });
+
+  const [run] = await sql<{ id: number }[]>`
+    insert into ingest.run (source, scope)
+    values ('showdown', 'champions')
+    returning id
+  `;
+  const runId = run.id;
+
+  try {
+    for (const [index, path] of FILES.entries()) {
+      if (index > 0) await sleep(REQUEST_INTERVAL_MS);
+
+      const content = await fetchRawFile(ref, path);
+      const hash = hashContent(content);
+      const inserted = await sql`
+        insert into ingest.snapshot
+          (run_id, source, page_key, entity_key, rev_id, content, content_hash)
+        values
+          (${runId}, 'showdown', ${path}, null, null, ${content}, ${hash})
+        on conflict (source, page_key, content_hash) do nothing
+        returning id
+      `;
+
+      stats.files.push({
+        path,
+        bytes: content.length,
+        hash: hash.slice(0, 12),
+        status: inserted.length > 0 ? 'inserted' : 'unchanged',
+      });
+    }
+
+    // 커밋을 못 받았으면 어느 시점 데이터인지 추적이 안 되므로 partial로 남긴다
+    const status = commit ? 'success' : 'partial';
+    await sql`
+      update ingest.run
+      set status = ${status}, finished_at = now(), stats = ${sql.json(stats)}
+      where id = ${runId}
+    `;
+    console.log(`[run ${runId}] ${status}`, JSON.stringify(stats, null, 2));
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    await sql`
+      update ingest.run
+      set status = 'failed', finished_at = now(),
+          stats = ${sql.json(stats)}, error = ${message}
+      where id = ${runId}
+    `;
+    console.error(`[run ${runId}] failed: ${message}`);
+    process.exitCode = 1;
+  } finally {
+    await sql.end();
+  }
+};
+
+// 테스트에서 import할 때는 실행하지 않는다
+if (import.meta.url === `file://${process.argv[1]}`) {
+  await main();
+}
diff --git a/scripts/ingest/generate-availability-proposals.mts b/scripts/ingest/generate-availability-proposals.mts
new file mode 100644
index 0000000..3dcd77e
--- /dev/null
+++ b/scripts/ingest/generate-availability-proposals.mts
@@ -0,0 +1,216 @@
+/**
+ * Bulbapedia 사용 가능 표(ingest.snapshot의 availability:gen7·8·9)와 version_move.is_usable을 비교해
+ * 다른 행을 ingest.move_proposal에 is_usable 수정 제안으로 쓴다.
+ *
+ * 규칙
+ * - 표의 {{yes}}만 사용 가능. {{no}}와 빈칸은 사용 불가.
+ * - 표와 DB는 기술 번호(move.move_number)로 맞춘다. DB id는 Z기술 이후 번호와 다르다.
+ * - Z기술처럼 같은 이름이 두 번호로 나오는 행은 하나로 합친다 (parseAvailabilityTable).
+ * - 본편 버전만 다룬다. 레전드 아르세우스(20)·레전드 Z-A(22)는 각자 테이블에서 다루므로
+ *   비교하지 않고 개수만 기록한다.
+ * - version_move 행이 없는 기술은 제안하지 않고 목록으로만 남긴다 (행을 만들려면 값이 필요).
+ * - 같은 대상·같은 값으로 거절된 제안은 다시 만들지 않는다.
+ *
+ * 실행 (fetch-availability-snapshot.mts 다음):
+ *   node --env-file=.env.local scripts/ingest/generate-availability-proposals.mts
+ */
+import postgres from 'postgres';
+
+import {
+  AVAILABILITY_PAGES,
+  parseAvailabilityTable,
+  type ParsedAvailability,
+} from './bulbapedia-availability-parser.mts';
+
+const PROJECT_REF = 'gdveyihxwjemujyhpgzy';
+const INSERT_BATCH_SIZE = 2000;
+
+/** 이 생성기가 바로잡는 본편 버전 그룹 */
+const MAINLINE_VGS = new Set([15, 16, 17, 18, 19, 21]);
+
+export type DbVersionMove = {
+  id: number;
+  move_id: number;
+  move_number: number;
+  identifier: string;
+  vg: number;
+  is_usable: boolean | null;
+};
+
+export type Proposal = {
+  target_table: 'version_move';
+  op: 'update';
+  target_key: { id: number };
+  field: 'is_usable';
+  current_value: string;
+  proposed_value: string;
+  payload: null;
+  source_values: Record<string, unknown>;
+  confidence: 'high';
+  note: string;
+};
+
+export const buildAvailabilityProposals = (
+  tables: { entityKey: string; revId: number | null; parsed: ParsedAvailability }[],
+  versionMoves: DbVersionMove[],
+): { proposals: Proposal[]; stats: Record<string, unknown> } => {
+  const proposals: Proposal[] = [];
+  const usableCount: Record<number, number> = {};
+  const missingRows: string[] = [];
+  const unknownNumbers: number[] = [];
+
+  const vmByKey = new Map(versionMoves.map((v) => [`${v.move_number}:${v.vg}`, v]));
+  const knownNumbers = new Set(versionMoves.map((v) => v.move_number));
+
+  for (const { entityKey, revId, parsed } of tables) {
+    for (const row of parsed.rows.values()) {
+      for (const [vg, usable] of row.usable) {
+        if (usable) usableCount[vg] = (usableCount[vg] ?? 0) + 1;
+        if (!MAINLINE_VGS.has(vg)) continue;
+
+        const vm = vmByKey.get(`${row.moveNumber}:${vg}`);
+        if (!vm) {
+          // 본편에서 쓸 수 없는 기술(예: Z-A 전용)은 version_move 행이 없어도 정상이다
+          if (!usable) continue;
+          if (!knownNumbers.has(row.moveNumber)) unknownNumbers.push(row.moveNumber);
+          else missingRows.push(`${row.moveNumber} ${row.name} @${vg}`);
+          continue;
+        }
+        const current = vm.is_usable !== false;
+        if (current === usable) continue;
+        proposals.push({
+          target_table: 'version_move',
+          op: 'update',
+          target_key: { id: vm.id },
+          field: 'is_usable',
+          current_value: String(vm.is_usable),
+          proposed_value: String(usable),
+          payload: null,
+          source_values: {
+            source: 'bulbapedia availability table',
+            entity_key: entityKey,
+            rev_id: revId,
+            move_id: vm.move_id,
+            move_number: row.moveNumber,
+            name_en: row.name,
+            version_group_id: vg,
+          },
+          confidence: 'high',
+          note: `${vm.identifier} @${vg} 사용 ${usable ? '가능' : '불가'} (표)`,
+        });
+      }
+    }
+  }
+
+  return {
+    proposals,
+    stats: {
+      usableCount,
+      missingRows,
+      unknownNumbers: [...new Set(unknownNumbers)],
+    },
+  };
+};
+
+const requireEnv = (key: string): string => {
+  const value = process.env[key];
+  if (!value) throw new Error(`${key} 환경 변수가 없습니다 (.env.local 확인)`);
+  return value;
+};
+
+const main = async () => {
+  const sql = postgres({
+    host: requireEnv('INGEST_DB_HOST'),
+    port: 5432,
+    database: 'postgres',
+    username: `ingest_bot.${PROJECT_REF}`,
+    password: requireEnv('INGEST_DB_PASSWORD'),
+    ssl: 'require',
+    max: 1,
+    prepare: false,
+  });
+
+  const [run] = await sql<{ id: number }[]>`
+    insert into ingest.run (source, scope) values ('generator', 'availability') returning id
+  `;
+  const runId = run.id;
+  let stats: Record<string, unknown> = {};
+
+  try {
+    const keys = AVAILABILITY_PAGES.map((p) => p.entityKey);
+    const snapshots = await sql<{ entity_key: string; rev_id: number | null; content: string }[]>`
+      select distinct on (entity_key) entity_key, rev_id::int, content
+      from ingest.snapshot
+      where source = 'bulbapedia' and entity_key in ${sql(keys)}
+      order by entity_key, fetched_at desc
+    `;
+    const missing = keys.filter((k) => !snapshots.some((s) => s.entity_key === k));
+    if (missing.length > 0) {
+      throw new Error(`원문이 없습니다: ${missing.join(', ')} (fetch-availability-snapshot.mts 먼저 실행)`);
+    }
+    // 표 형식이 바뀌면 parseAvailabilityTable이 예외를 던져 제안 없이 끝난다
+    const tables = snapshots.map((s) => ({
+      entityKey: s.entity_key,
+      revId: s.rev_id,
+      parsed: parseAvailabilityTable(s.content),
+    }));
+
+    const versionMoves = await sql<DbVersionMove[]>`
+      select v.id::int, v.move_id::int, m.move_number::int, m.identifier,
+             v.version_group_id::int as vg, v.is_usable
+      from public.version_move v join public.move m on m.id = v.move_id
+    `;
+
+    const result = buildAvailabilityProposals(tables, versionMoves);
+    stats = result.stats;
+
+    let inserted = 0;
+    for (let i = 0; i < result.proposals.length; i += INSERT_BATCH_SIZE) {
+      const batch = result.proposals.slice(i, i + INSERT_BATCH_SIZE);
+      const res = await sql<{ id: number }[]>`
+        insert into ingest.move_proposal
+          (run_id, target_table, op, target_key, field, current_value,
+           proposed_value, payload, source_values, confidence, note)
+        select ${runId}, r.target_table, r.op, r.target_key, r.field, r.current_value,
+               r.proposed_value, r.payload, r.source_values, r.confidence, r.note
+        from jsonb_to_recordset(${sql.json(batch as unknown as postgres.JSONValue)}::jsonb) as r(
+          target_table text, op text, target_key jsonb, field text,
+          current_value text, proposed_value text, payload jsonb,
+          source_values jsonb, confidence text, note text)
+        where not exists (
+          select 1 from ingest.move_proposal x
+          where x.status = 'rejected'
+            and x.target_table = r.target_table and x.op = r.op and x.target_key = r.target_key
+            and coalesce(x.field, '') = coalesce(r.field, '')
+            and x.proposed_value is not distinct from r.proposed_value
+        )
+        on conflict (target_table, op, target_key, (coalesce(field, ''))) where status = 'pending'
+        do nothing
+        returning id
+      `;
+      inserted += res.length;
+    }
+    stats = { ...stats, proposals: result.proposals.length, inserted };
+
+    await sql`
+      update ingest.run set status = 'success', finished_at = now(), stats = ${sql.json(stats as postgres.JSONValue)}
+      where id = ${runId}
+    `;
+    console.log(`[run ${runId}] success`, stats);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    await sql`
+      update ingest.run set status = 'failed', finished_at = now(),
+             stats = ${sql.json(stats as postgres.JSONValue)}, error = ${message}
+      where id = ${runId}
+    `;
+    console.error(`[run ${runId}] failed: ${message}`);
+    process.exitCode = 1;
+  } finally {
+    await sql.end();
+  }
+};
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  await main();
+}
diff --git a/scripts/ingest/generate-bulbapedia-move-proposals.mts b/scripts/ingest/generate-bulbapedia-move-proposals.mts
new file mode 100644
index 0000000..66d63f7
--- /dev/null
+++ b/scripts/ingest/generate-bulbapedia-move-proposals.mts
@@ -0,0 +1,745 @@
+/**
+ * Bulbapedia 기술 원문(ingest.snapshot)과 DB를 비교해 제안을 ingest.move_proposal에 쓴다.
+ * 두 단계로 나눠 실행한다. 변경 이력은 버전별 값이 바로잡힌 뒤에 만들어야 정확하기 때문이다.
+ *
+ *   --phase=values   (먼저)
+ *     A. move           현재 값 (위력·명중·PP·우선도·타입·분류·접촉)
+ *     B. version_move   툴팁에 명시된 과거 세대 값, 최신 본가 버전의 현재 값
+ *     D. version_move_legends_za  ZA 템플릿 값
+ *     (Champions 값·이력은 generate-champions-move-proposals가 만든다)
+ *
+ *   --phase=history  (values 제안을 반영한 뒤)
+ *     C. move_change_log  version_move 버전 간 변화 중 기록에 없는 것
+ *
+ * 비교 규칙 (902개 실제 원문으로 검증)
+ * - 툴팁이 없는 과거 세대에는 현재 값을 퍼뜨리지 않는다 (인포박스 툴팁이 불완전한 기술이 있음)
+ * - Bulbapedia 값이 Champions 값과 같으면 Champions 값을 보여주는 것으로 본다 (move는 SV 기준)
+ * - Bulbapedia 값이 이 기술의 다른 버전 행 값과 같으면 그 버전을 보여주는 것으로 본다 (파트너 기술)
+ * - 레츠고 행은 레츠고를 명시한 툴팁이 있을 때만 비교한다
+ * - 사용 불가(is_usable=false) 행은 건드리지 않는다
+ * - 본편 버전만 비교한다. 레전드 아르세우스·레전드 Z-A·챔피언스는 각자 테이블에서 다룬다
+ * - move는 본편 최신 값이다. Bulbapedia 인포박스가 Champions 값을 보여주면 move를 바꾸지 않는다
+ * - 해석할 수 없는 툴팁은 추측하지 않고 건너뛴 뒤 기록한다
+ *
+ * 실행:
+ *   node --env-file=.env.local scripts/ingest/generate-bulbapedia-move-proposals.mts --phase=values
+ *   node --env-file=.env.local scripts/ingest/generate-bulbapedia-move-proposals.mts --phase=history
+ */
+import postgres from 'postgres';
+
+import {
+  categoryBeforeGen4,
+  expectedByVersionGroup,
+  isMainline,
+  parseHistory,
+  parseInfobox,
+  parseLegendsZa,
+  parseNumber,
+  VG_CHAMPIONS,
+  VG_LEGENDS_ARCEUS,
+  VG_LEGENDS_ZA,
+  VG_LGPE,
+  type HistorySegment,
+  type ParsedMove,
+  type ParsedZa,
+  type VersionGroup,
+} from './bulbapedia-move-parser.mts';
+
+const PROJECT_REF = 'gdveyihxwjemujyhpgzy';
+const INSERT_BATCH_SIZE = 2000;
+
+/** version_move에서 비교하는 본편 버전 그룹 (레전드 아르세우스·레전드 Z-A·챔피언스 제외) */
+const MAINLINE_VG = (vg: number) =>
+  vg !== VG_LEGENDS_ARCEUS && vg !== VG_LEGENDS_ZA && vg !== VG_CHAMPIONS;
+
+// ─── DB 상태 ─────────────────────────────────────────────────────
+
+export type DbMove = {
+  id: number;
+  identifier: string;
+  power: number | null;
+  pp: number;
+  accuracy: number | null;
+  priority: number;
+  type_id: number;
+  damage_class_id: number;
+  is_contact: boolean;
+};
+
+export type DbVersionMove = {
+  id: number;
+  move_id: number;
+  vg: number;
+  power: number | null;
+  pp: number | null;
+  accuracy: number | null;
+  priority: number | null;
+  type_id: number;
+  damage_class_id: number | null;
+  effect_chance: number | null;
+  is_usable: boolean | null;
+};
+
+export type DbZa = {
+  id: number;
+  base_move_id: number;
+  variant: string;
+  power: number | null;
+  cooldown: number | null;
+  type_id: number;
+  damage_class_id: number;
+  frames_wind_up: number | null;
+  duration: number | null;
+};
+
+export type DbState = {
+  moves: DbMove[];
+  vm: DbVersionMove[];
+  champ: { base_move_id: number; power: number | null; accuracy: number | null; type_id: number | null }[];
+  za: DbZa[];
+  types: { id: number; identifier: string; name_ko: string }[];
+  dcs: { id: number; identifier: string; name_ko: string }[];
+  vgs: VersionGroup[];
+  log: { move_id: number; vg: number; field: string; old: string | null; new: string | null }[];
+};
+
+// ─── 제안 ────────────────────────────────────────────────────────
+
+export type Proposal = {
+  target_table: 'move' | 'version_move' | 'version_move_legends_za' | 'move_change_log';
+  op: 'insert' | 'update';
+  target_key: Record<string, string | number>;
+  field: string | null;
+  current_value: string | null;
+  proposed_value: string | null;
+  payload: Record<string, string | number | null> | null;
+  source_values: Record<string, unknown>;
+  confidence: 'high' | 'medium' | 'conflict';
+  note: string;
+};
+
+const text = (v: number | boolean | string | null | undefined): string | null =>
+  v == null ? null : String(v);
+
+// 변화 기술 일부가 위력 0으로 저장돼 있어 '없음'과 같게 본다
+const sameValue = (field: string, a: number | null, b: number | null) => {
+  const n = (v: number | null) => (field === 'power' && v === 0 ? null : v);
+  return n(a) === n(b);
+};
+
+const NUMERIC_FIELDS = [
+  { key: 'power', col: 'power', label: '위력' },
+  { key: 'accuracy', col: 'accuracy', label: '명중' },
+  { key: 'pp', col: 'pp', label: 'PP' },
+  { key: 'priority', col: 'priority', label: '우선도' },
+] as const;
+
+export type ParsedSnapshot = {
+  moveId: number;
+  pageKey: string;
+  infobox: ParsedMove | null;
+  za: ParsedZa | null;
+};
+
+export type ValuesResult = {
+  proposals: Proposal[];
+  unparsedNotes: string[];
+  skipped: Record<string, number>;
+};
+
+// ─── values 단계 ─────────────────────────────────────────────────
+
+export const buildValueProposals = (snapshots: ParsedSnapshot[], db: DbState): ValuesResult => {
+  const proposals: Proposal[] = [];
+  const unparsedNotes: string[] = [];
+  const skipped: Record<string, number> = {};
+  const skip = (reason: string) => {
+    skipped[reason] = (skipped[reason] ?? 0) + 1;
+  };
+
+  const moveById = new Map(db.moves.map((m) => [m.id, m]));
+  const champByMove = new Map(db.champ.map((c) => [c.base_move_id, c]));
+  const typeById = new Map(db.types.map((t) => [t.id, t]));
+  const typeByIdentifier = new Map(db.types.map((t) => [t.identifier, t]));
+  const dcById = new Map(db.dcs.map((d) => [d.id, d]));
+  const dcByIdentifier = new Map(db.dcs.map((d) => [d.identifier, d]));
+  const vgById = new Map(db.vgs.map((vg) => [vg.id, vg]));
+  const mainline = db.vgs.filter(isMainline);
+  const vmByMove = new Map<number, DbVersionMove[]>();
+  for (const row of db.vm) {
+    if (!MAINLINE_VG(row.vg)) continue;
+    const list = vmByMove.get(row.move_id) ?? [];
+    list.push(row);
+    vmByMove.set(row.move_id, list);
+  }
+  for (const list of vmByMove.values()) {
+    list.sort((a, b) => (vgById.get(a.vg)?.sort_order ?? 0) - (vgById.get(b.vg)?.sort_order ?? 0));
+  }
+  const zaByMove = new Map<number, DbZa[]>();
+  for (const row of db.za) {
+    const list = zaByMove.get(row.base_move_id) ?? [];
+    list.push(row);
+    zaByMove.set(row.base_move_id, list);
+  }
+
+  for (const snap of snapshots) {
+    const move = moveById.get(snap.moveId);
+    const box = snap.infobox;
+    if (!move || !box) {
+      skip('인포박스 없음');
+      continue;
+    }
+    const rows = vmByMove.get(move.id) ?? [];
+    const usableRows = rows.filter((r) => r.is_usable !== false);
+    const latest = usableRows.at(-1);
+    const champ = champByMove.get(move.id);
+    const source = { page: snap.pageKey };
+
+    for (const { key, col, label } of NUMERIC_FIELDS) {
+      const fv = box.fields[key];
+      if (!fv) continue;
+      const current = parseNumber(fv.current);
+      if (current === undefined) {
+        skip(`${label}: 숫자가 아님`);
+        continue;
+      }
+      let segments: HistorySegment[] = [];
+      if (fv.history) {
+        const parsed = parseHistory(fv.history, db.vgs);
+        if (!parsed) {
+          unparsedNotes.push(`${move.identifier}.${key}: ${fv.history}`);
+          continue;
+        }
+        segments = parsed;
+      }
+      const championsSegment = segments.find((s) => s.priorToChampions);
+      const mainValue = championsSegment ? championsSegment.value : current;
+
+      // Z기술·다이맥스 기술처럼 PP 개념이 없는 기술
+      if (key === 'pp' && mainValue === null) {
+        skip('PP 없음(Z·다이맥스)');
+        continue;
+      }
+
+      // Bulbapedia 값이 무엇을 보여주는지 판단
+      const showsChampions =
+        !championsSegment &&
+        champ != null &&
+        (key === 'power' || key === 'accuracy') &&
+        sameValue(key, mainValue, champ[key]);
+      const showsOtherVersion =
+        latest != null &&
+        sameValue(key, move[col], latest[col]) &&
+        rows.some((r) => r !== latest && sameValue(key, mainValue, r[col]));
+
+      // A. move
+      if (!sameValue(key, mainValue, move[col])) {
+        if (showsChampions) skip(`${label}: Champions 값 표시`);
+        else if (showsOtherVersion) skip(`${label}: 다른 버전 값 표시`);
+        else {
+          proposals.push({
+            target_table: 'move',
+            op: 'update',
+            target_key: { id: move.id },
+            field: col,
+            current_value: text(move[col]),
+            proposed_value: text(mainValue),
+            payload: null,
+            source_values: { ...source, bulbapedia: fv.current, tooltip: fv.history },
+            confidence: 'medium',
+            note: `${label} (Bulbapedia 인포박스)`,
+          });
+        }
+      }
+
+      // B. version_move
+      const explicit = new Map<number, number | null>();
+      if (segments.length > 0) {
+        const expected = expectedByVersionGroup(current, segments, mainline);
+        for (const [vgId, e] of expected) if (e.explicit) explicit.set(vgId, e.value);
+      }
+      const lgpeNamed = segments.some((s) => s.vgIds.length === 1 && s.vgIds[0] === VG_LGPE);
+
+      for (const row of usableRows) {
+        let expectedValue: number | null;
+        let fromTooltip: boolean;
+        if (row.vg === VG_LGPE && !lgpeNamed) continue;
+        if (explicit.has(row.vg)) {
+          expectedValue = explicit.get(row.vg) ?? null;
+          fromTooltip = true;
+        } else if (row === latest) {
+          if (showsChampions || showsOtherVersion) continue;
+          expectedValue = mainValue;
+          fromTooltip = false;
+        } else {
+          continue;
+        }
+        if (sameValue(key, expectedValue, row[col])) continue;
+
+        const vgName = vgById.get(row.vg);
+        proposals.push({
+          target_table: 'version_move',
+          op: 'update',
+          target_key: { id: row.id },
+          field: col,
+          current_value: text(row[col]),
+          proposed_value: text(expectedValue),
+          payload: null,
+          source_values: {
+            ...source,
+            move_id: move.id,
+            version_group_id: row.vg,
+            bulbapedia: fv.current,
+            tooltip: fv.history,
+          },
+          confidence: fromTooltip ? 'high' : 'medium',
+          note: `${move.identifier} ${label} @${vgName?.id} (${fromTooltip ? '툴팁 명시' : '최신 버전 현재 값'})`,
+        });
+      }
+    }
+
+    // A. 타입 (move는 본편 값. 인포박스가 Champions 타입을 보여주면 건드리지 않는다)
+    if (box.type) {
+      const bulbaType = typeByIdentifier.get(box.type);
+      if (!bulbaType) skip('타입: 알 수 없는 값');
+      else if (bulbaType.id !== move.type_id) {
+        const champType = champ?.type_id ?? null;
+        const oldType = typeById.get(move.type_id);
+        if (champType === bulbaType.id) skip('타입: Champions 값 표시');
+        else {
+          proposals.push({
+            target_table: 'move',
+            op: 'update',
+            target_key: { id: move.id },
+            field: 'type_id',
+            current_value: text(move.type_id),
+            proposed_value: text(bulbaType.id),
+            payload: null,
+            source_values: { ...source, bulbapedia: box.type, champions_type_id: champType },
+            confidence: 'conflict',
+            note: `타입 ${oldType?.name_ko} → ${bulbaType.name_ko} (본편 값과 다름, 확인 필요)`,
+          });
+        }
+      }
+    }
+
+    // A. 분류
+    if (box.category && box.category !== 'varies') {
+      const dc = dcByIdentifier.get(box.category);
+      if (!dc) skip('분류: 알 수 없는 값');
+      else if (dc.id !== move.damage_class_id) {
+        proposals.push({
+          target_table: 'move',
+          op: 'update',
+          target_key: { id: move.id },
+          field: 'damage_class_id',
+          current_value: text(move.damage_class_id),
+          proposed_value: text(dc.id),
+          payload: null,
+          source_values: { ...source, bulbapedia: box.category },
+          confidence: 'conflict',
+          note: `분류 ${dcById.get(move.damage_class_id)?.name_ko} → ${dc.name_ko} (확인 필요)`,
+        });
+      }
+    }
+
+    // A. 접촉
+    if (box.contact != null && box.contact !== move.is_contact) {
+      proposals.push({
+        target_table: 'move',
+        op: 'update',
+        target_key: { id: move.id },
+        field: 'is_contact',
+        current_value: text(move.is_contact),
+        proposed_value: text(box.contact),
+        payload: null,
+        source_values: source,
+        confidence: 'medium',
+        note: '접촉 여부 (Bulbapedia 인포박스)',
+      });
+    }
+
+    // E. 4세대 이전 분류 규칙 (타입으로 결정)
+    for (const row of usableRows) {
+      const generation = vgById.get(row.vg)?.generation ?? 99;
+      if (generation >= 4 || row.damage_class_id == null) continue;
+      const dc = dcById.get(row.damage_class_id);
+      if (!dc || dc.identifier === 'status') continue;
+      const want = categoryBeforeGen4(typeById.get(row.type_id)?.identifier ?? 'unknown');
+      const wantDc = want ? dcByIdentifier.get(want) : undefined;
+      if (wantDc && wantDc.id !== row.damage_class_id) {
+        proposals.push({
+          target_table: 'version_move',
+          op: 'update',
+          target_key: { id: row.id },
+          field: 'damage_class_id',
+          current_value: text(row.damage_class_id),
+          proposed_value: text(wantDc.id),
+          payload: null,
+          source_values: { move_id: move.id, version_group_id: row.vg, rule: 'type-based category before Gen IV' },
+          confidence: 'high',
+          note: `${move.identifier} 분류 @${row.vg} (4세대 이전은 타입으로 결정)`,
+        });
+      }
+    }
+
+    // D. ZA
+    if (snap.za) {
+      const zaRows = zaByMove.get(move.id) ?? [];
+      const base = zaRows.find((r) => r.variant === 'base');
+      const plus = zaRows.find((r) => r.variant === 'plus');
+      if (!base) {
+        skip('ZA: DB 행 없음');
+      } else {
+        const za = snap.za;
+        const zaType = za.type ? typeByIdentifier.get(za.type) : undefined;
+        if (zaType && zaType.id !== base.type_id) {
+          proposals.push({
+            target_table: 'version_move_legends_za',
+            op: 'update',
+            target_key: { id: base.id },
+            field: 'type_id',
+            current_value: text(base.type_id),
+            proposed_value: text(zaType.id),
+            payload: null,
+            source_values: { ...source, bulbapedia: za.type },
+            confidence: 'conflict',
+            note: `${move.identifier} ZA 타입 (타입 변경은 move·이력도 함께 확인 필요)`,
+          });
+        }
+        const zaDc = za.category ? dcByIdentifier.get(za.category) : undefined;
+        if (zaDc && zaDc.id !== base.damage_class_id) {
+          proposals.push({
+            target_table: 'version_move_legends_za',
+            op: 'update',
+            target_key: { id: base.id },
+            field: 'damage_class_id',
+            current_value: text(base.damage_class_id),
+            proposed_value: text(zaDc.id),
+            payload: null,
+            source_values: { ...source, bulbapedia: za.category },
+            confidence: 'conflict',
+            note: `${move.identifier} ZA 분류 ${dcById.get(base.damage_class_id)?.name_ko} → ${zaDc.name_ko} (확인 필요)`,
+          });
+        }
+
+        const zaFields = [
+          { key: 'power', col: 'power', label: '위력' },
+          { key: 'cooldown', col: 'cooldown', label: '쿨타임' },
+          { key: 'windUp', col: 'frames_wind_up', label: '발동' },
+          { key: 'duration', col: 'duration', label: '지속' },
+        ] as const;
+        for (const [variant, row, values] of [
+          ['base', base, za.base],
+          ['plus', plus, za.plus],
+        ] as const) {
+          if (!row) continue;
+          for (const { key, col, label } of zaFields) {
+            const value = values[key];
+            if (value === undefined) continue;
+            // 고정 데미지·무게 비례 기술은 Bulbapedia가 위력 1로 표시한다
+            if (key === 'power' && value != null && value <= 1 && row.power == null) {
+              skip('ZA 위력: 가변 위력');
+              continue;
+            }
+            if (sameValue(key, value, row[col])) continue;
+            proposals.push({
+              target_table: 'version_move_legends_za',
+              op: 'update',
+              target_key: { id: row.id },
+              field: col,
+              current_value: text(row[col]),
+              proposed_value: text(value),
+              payload: null,
+              source_values: { ...source, variant },
+              confidence: row[col] == null ? 'high' : 'medium',
+              note: `${move.identifier} ZA ${variant} ${label}${row[col] == null ? ' (빈 값 채움)' : ''}`,
+            });
+          }
+        }
+      }
+    }
+  }
+
+  return { proposals, unparsedNotes, skipped };
+};
+
+// ─── history 단계 ────────────────────────────────────────────────
+
+export const buildHistoryProposals = (
+  db: DbState,
+  snapshots: ParsedSnapshot[],
+): { proposals: Proposal[]; existingDifferent: string[] } => {
+  const proposals: Proposal[] = [];
+  const existingDifferent: string[] = [];
+
+  const moveById = new Map(db.moves.map((m) => [m.id, m]));
+  const vgById = new Map(db.vgs.map((vg) => [vg.id, vg]));
+  const typeName = new Map(db.types.map((t) => [t.id, t.name_ko]));
+  const dcName = new Map(db.dcs.map((d) => [d.id, d.name_ko]));
+  const mainline = db.vgs.filter(isMainline);
+  const logged = new Map(db.log.map((l) => [`${l.move_id}|${l.vg}|${l.field}`, l]));
+  const snapByMove = new Map(snapshots.map((s) => [s.moveId, s]));
+
+  const fmt = (v: number | null) => (v == null ? '—' : String(v));
+  const fields = [
+    { label: '위력', get: (r: DbVersionMove) => fmt(r.power === 0 ? null : r.power), tooltip: 'power' },
+    { label: 'PP', get: (r: DbVersionMove) => fmt(r.pp), tooltip: 'pp' },
+    { label: '명중', get: (r: DbVersionMove) => fmt(r.accuracy), tooltip: 'accuracy' },
+    { label: '우선도', get: (r: DbVersionMove) => fmt(r.priority), tooltip: 'priority' },
+    // 1세대 일부 기술은 추가효과 없음이 0으로 저장돼 있다. 기존 기록 형식('—')에 맞춘다
+    { label: '추가효과 확률', get: (r: DbVersionMove) => fmt(r.effect_chance === 0 ? null : r.effect_chance), tooltip: null },
+    { label: '분류', get: (r: DbVersionMove) => (r.damage_class_id == null ? '—' : (dcName.get(r.damage_class_id) ?? '?')), tooltip: null },
+    { label: '타입', get: (r: DbVersionMove) => typeName.get(r.type_id) ?? '?', tooltip: null },
+  ] as const;
+
+  const chains = new Map<number, DbVersionMove[]>();
+  for (const row of db.vm) {
+    if (!MAINLINE_VG(row.vg) || row.is_usable === false) continue;
+    const list = chains.get(row.move_id) ?? [];
+    list.push(row);
+    chains.set(row.move_id, list);
+  }
+
+  for (const [moveId, chain] of chains) {
+    chain.sort((a, b) => (vgById.get(a.vg)?.sort_order ?? 0) - (vgById.get(b.vg)?.sort_order ?? 0));
+    const move = moveById.get(moveId);
+    if (!move) continue;
+
+    // 툴팁이 이전 값을 명시하면 high
+    const box = snapByMove.get(moveId)?.infobox;
+    const tooltipExpected = new Map<string, Map<number, number | null>>();
+    for (const key of ['power', 'pp', 'accuracy', 'priority'] as const) {
+      const fv = box?.fields[key];
+      if (!fv?.history) continue;
+      const current = parseNumber(fv.current);
+      const segments = parseHistory(fv.history, db.vgs);
+      if (current === undefined || !segments) continue;
+      const explicit = new Map<number, number | null>();
+      for (const [vgId, e] of expectedByVersionGroup(current, segments, mainline)) {
+        if (e.explicit) explicit.set(vgId, e.value);
+      }
+      tooltipExpected.set(key, explicit);
+    }
+
+    for (let i = 1; i < chain.length; i += 1) {
+      const prev = chain[i - 1];
+      const next = chain[i];
+      for (const f of fields) {
+        const oldValue = f.get(prev);
+        const newValue = f.get(next);
+        if (oldValue === newValue) continue;
+
+        const existing = logged.get(`${moveId}|${next.vg}|${f.label}`);
+        if (existing) {
+          if (existing.old !== oldValue || existing.new !== newValue) {
+            existingDifferent.push(
+              `${move.identifier} @${next.vg} ${f.label}: 기록 ${existing.old}→${existing.new} / 버전값 ${oldValue}→${newValue}`,
+            );
+          }
+          continue;
+        }
+
+        const tooltipPrev = f.tooltip ? tooltipExpected.get(f.tooltip)?.get(prev.vg) : undefined;
+        const confirmed = tooltipPrev !== undefined && fmt(tooltipPrev) === oldValue;
+        proposals.push({
+          target_table: 'move_change_log',
+          op: 'insert',
+          target_key: { move_id: moveId, version_group_id: next.vg, field: f.label },
+          field: null,
+          current_value: null,
+          proposed_value: null,
+          payload: {
+            move_id: moveId,
+            version_group_id: next.vg,
+            field: f.label,
+            old_value: oldValue,
+            new_value: newValue,
+          },
+          source_values: { from_version_group_id: prev.vg, to_version_group_id: next.vg },
+          confidence: confirmed ? 'high' : 'medium',
+          note: `${move.identifier} ${f.label} ${oldValue} → ${newValue} @${next.vg}${confirmed ? ' (Bulbapedia 툴팁 확인)' : ''}`,
+        });
+      }
+    }
+  }
+
+  return { proposals, existingDifferent };
+};
+
+// ─── 실행 ────────────────────────────────────────────────────────
+
+const requireEnv = (key: string): string => {
+  const value = process.env[key];
+  if (!value) throw new Error(`${key} 환경 변수가 없습니다 (.env.local 확인)`);
+  return value;
+};
+
+const parsePhase = (): 'values' | 'history' => {
+  const arg = process.argv.find((a) => a.startsWith('--phase='));
+  const phase = arg?.slice('--phase='.length);
+  if (phase !== 'values' && phase !== 'history') {
+    throw new Error('사용법: generate-bulbapedia-move-proposals.mts --phase=values|history');
+  }
+  return phase;
+};
+
+const loadDbState = async (sql: postgres.Sql): Promise<DbState> => {
+  // bigint는 문자열로 오므로 ::int로 받는다
+  const [moves, vm, champ, za, types, dcs, vgs, log] = await Promise.all([
+    sql<DbMove[]>`
+      select id::int, identifier, power, pp, accuracy, priority, type_id::int,
+             damage_class_id::int, is_contact
+      from public.move`,
+    sql<DbVersionMove[]>`
+      select id::int, move_id::int, version_group_id::int as vg, power, pp, accuracy, priority,
+             type_id::int, damage_class_id::int, effect_chance, is_usable
+      from public.version_move`,
+    sql<DbState['champ']>`
+      select base_move_id::int, power, accuracy, type_id::int from public.champions_move`,
+    sql<DbZa[]>`
+      select id::int, base_move_id::int, za_variant as variant, power, cooldown, type_id::int,
+             damage_class_id::int, frames_wind_up, duration
+      from public.version_move_legends_za`,
+    sql<DbState['types']>`select id::int, identifier, name_ko from public.type`,
+    sql<DbState['dcs']>`select id::int, identifier, name_ko from public.damage_class`,
+    sql<VersionGroup[]>`select id::int, generation, sort_order from public.version_group`,
+    sql<DbState['log']>`
+      select move_id::int, version_group_id::int as vg, field, old_value as old, new_value as new
+      from public.move_change_log`,
+  ]);
+  return { moves, vm, champ, za, types, dcs, vgs, log };
+};
+
+const loadSnapshots = async (sql: postgres.Sql): Promise<ParsedSnapshot[]> => {
+  const rows = await sql<{ entity_key: string; page_key: string; content: string }[]>`
+    select distinct on (entity_key) entity_key, page_key, content
+    from ingest.snapshot
+    where source = 'bulbapedia' and entity_key like 'move:%'
+    order by entity_key, fetched_at desc
+  `;
+  return rows.map((r) => ({
+    moveId: Number(r.entity_key.slice('move:'.length)),
+    pageKey: r.page_key,
+    infobox: parseInfobox(r.content),
+    za: parseLegendsZa(r.content),
+  }));
+};
+
+const main = async () => {
+  const phase = parsePhase();
+  const sql = postgres({
+    host: requireEnv('INGEST_DB_HOST'),
+    port: 5432,
+    database: 'postgres',
+    username: `ingest_bot.${PROJECT_REF}`,
+    password: requireEnv('INGEST_DB_PASSWORD'),
+    ssl: 'require',
+    max: 1,
+    prepare: false,
+  });
+
+  const [run] = await sql<{ id: number }[]>`
+    insert into ingest.run (source, scope)
+    values ('generator', ${`bulbapedia-move:${phase}`})
+    returning id
+  `;
+  const runId = run.id;
+  const stats: Record<string, unknown> = {};
+
+  try {
+    if (phase === 'history') {
+      const [{ pending }] = await sql<{ pending: number }[]>`
+        select count(*)::int as pending from ingest.move_proposal
+        where status = 'pending' and target_table in ('move', 'version_move')
+      `;
+      if (pending > 0) {
+        throw new Error(
+          `반영되지 않은 values 제안이 ${pending}건 있습니다. 먼저 반영하거나 거절한 뒤 history를 실행하세요`,
+        );
+      }
+    }
+
+    const [db, snapshots] = await Promise.all([loadDbState(sql), loadSnapshots(sql)]);
+    stats.snapshots = snapshots.length;
+
+    let proposals: Proposal[];
+    if (phase === 'values') {
+      const result = buildValueProposals(snapshots, db);
+      proposals = result.proposals;
+      stats.unparsedNotes = result.unparsedNotes;
+      stats.skipped = result.skipped;
+    } else {
+      const result = buildHistoryProposals(db, snapshots);
+      proposals = result.proposals;
+      stats.existingDifferent = result.existingDifferent;
+    }
+
+    let inserted = 0;
+    for (let i = 0; i < proposals.length; i += INSERT_BATCH_SIZE) {
+      const batch = proposals.slice(i, i + INSERT_BATCH_SIZE);
+      // 문자열(JSON.stringify)을 넘기면 jsonb로 한 번 더 감싸지므로 배열을 sql.json()으로 넘긴다
+      const res = await sql<{ id: number }[]>`
+        insert into ingest.move_proposal
+          (run_id, target_table, op, target_key, field, current_value,
+           proposed_value, payload, source_values, confidence, note)
+        select ${runId}, r.target_table, r.op, r.target_key, r.field, r.current_value,
+               r.proposed_value, r.payload, r.source_values, r.confidence, r.note
+        from jsonb_to_recordset(${sql.json(batch as unknown as postgres.JSONValue)}::jsonb) as r(
+          target_table text, op text, target_key jsonb, field text,
+          current_value text, proposed_value text, payload jsonb,
+          source_values jsonb, confidence text, note text)
+        -- 같은 대상·같은 값으로 이미 거절된 제안은 다시 만들지 않는다 (값이 바뀌면 새로 올라온다)
+        where not exists (
+          select 1 from ingest.move_proposal x
+          where x.status = 'rejected'
+            and x.target_table = r.target_table and x.op = r.op and x.target_key = r.target_key
+            and coalesce(x.field, '') = coalesce(r.field, '')
+            and x.proposed_value is not distinct from r.proposed_value
+            and x.payload is not distinct from r.payload
+        )
+        on conflict (target_table, op, target_key, (coalesce(field, '')))
+          where status = 'pending'
+        do nothing
+        returning id
+      `;
+      inserted += res.length;
+    }
+
+    const byKind: Record<string, number> = {};
+    for (const p of proposals) {
+      const k = `${p.target_table}.${p.field ?? p.op} [${p.confidence}]`;
+      byKind[k] = (byKind[k] ?? 0) + 1;
+    }
+    Object.assign(stats, {
+      proposals: proposals.length,
+      inserted,
+      skippedAsDuplicate: proposals.length - inserted,
+      byKind,
+    });
+
+    await sql`
+      update ingest.run
+      set status = 'success', finished_at = now(), stats = ${sql.json(stats as postgres.JSONValue)}
+      where id = ${runId}
+    `;
+    console.log(`[run ${runId}] success`, JSON.stringify(stats, null, 2));
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    await sql`
+      update ingest.run
+      set status = 'failed', finished_at = now(),
+          stats = ${sql.json(stats as postgres.JSONValue)}, error = ${message}
+      where id = ${runId}
+    `;
+    console.error(`[run ${runId}] failed: ${message}`);
+    process.exitCode = 1;
+  } finally {
+    await sql.end();
+  }
+};
+
+// 테스트에서 import할 때는 실행하지 않는다
+if (import.meta.url === `file://${process.argv[1]}`) {
+  await main();
+}
diff --git a/scripts/ingest/generate-champions-learnset-proposals.mts b/scripts/ingest/generate-champions-learnset-proposals.mts
new file mode 100644
index 0000000..6029dca
--- /dev/null
+++ b/scripts/ingest/generate-champions-learnset-proposals.mts
@@ -0,0 +1,465 @@
+/**
+ * 최신 Showdown 스냅샷과 현재 DB를 비교해 Champions 배우는 기술 제안을 ingest.move_proposal에 쓴다.
+ *
+ * 만드는 제안 (대상: champions_poke_move)
+ * - insert: Showdown에는 있는데 DB에 없는 (포켓몬, 기술)
+ * - delete: 별칭 포켓몬(메가진화 등) 행. owner 행이 있어 champions_learnset 뷰가 읽지 않는 중복
+ * - delete: Showdown 기준 Champions에서 배우지 않는 (포켓몬, 기술)
+ *
+ * 저장 원칙: learnset 테이블에는 owner 포켓몬(learnset_owner_key가 없는 쪽)만 저장한다.
+ * 별칭은 champions_learnset 뷰가 owner로 풀어서 보여준다.
+ *
+ * 포켓몬 매핑: Showdown ID = poke_key에서 영숫자만 남긴 것.
+ *   예외: 암컷 폼 (Showdown forme "F", 예: meowsticf) → <기본종 poke_key>-female
+ *   도감번호가 다르면 매핑 실패로 본다.
+ *
+ * 안전장치
+ * - Showdown 파일은 실행하지 않고 TypeScript 구문 트리로만 읽는다.
+ * - 포켓몬·기술 매핑에 하나라도 실패하면 삭제 제안을 만들지 않는다.
+ * - 같은 owner로 모이는 Showdown 폼끼리 learnset이 다르면 그 owner는 건너뛰고 기록한다.
+ * - owner 행 삭제 제안이 비정상적으로 많으면 (Showdown 데이터 이상 의심) 실패로 끝낸다.
+ * - public 스키마는 읽기만 한다 (ingest_bot 권한).
+ *
+ * 실행: node --env-file=.env.local scripts/ingest/generate-champions-learnset-proposals.mts
+ */
+import postgres from 'postgres';
+import ts from 'typescript';
+
+const PROJECT_REF = 'gdveyihxwjemujyhpgzy';
+
+const FILE_LEARNSETS = 'data/mods/champions/learnsets.ts';
+const FILE_POKEDEX = 'data/pokedex.ts';
+
+// 한 번에 넣는 제안 수 (쿼리 파라미터 크기 제한)
+const INSERT_BATCH_SIZE = 2000;
+
+// owner 행 삭제가 이보다 많으면 데이터 이상으로 보고 멈춘다
+const MAX_OWNER_DELETES = 50;
+
+// ─── Showdown 데이터 (구문 트리로 읽은 값) ─────────────────────────
+
+export type ShowdownSpecies = {
+  num: number;
+  name: string;
+  baseSpecies: string | null;
+  forme: string | null;
+};
+
+const propertyName = (name: ts.PropertyName): string | null => {
+  if (ts.isIdentifier(name) || ts.isStringLiteralLike(name)) return name.text;
+  return null;
+};
+
+/** `export const X = { id: { ... }, ... }` 의 최상위 객체 항목들 */
+const topLevelEntries = (
+  source: string,
+): [string, ts.ObjectLiteralExpression][] => {
+  const file = ts.createSourceFile('data.ts', source, ts.ScriptTarget.Latest);
+  const entries: [string, ts.ObjectLiteralExpression][] = [];
+
+  for (const statement of file.statements) {
+    if (!ts.isVariableStatement(statement)) continue;
+    for (const decl of statement.declarationList.declarations) {
+      let init = decl.initializer;
+      while (init && (ts.isAsExpression(init) || ts.isSatisfiesExpression(init))) {
+        init = init.expression;
+      }
+      if (!init || !ts.isObjectLiteralExpression(init)) continue;
+
+      for (const prop of init.properties) {
+        if (!ts.isPropertyAssignment(prop)) continue;
+        const id = propertyName(prop.name);
+        if (id && ts.isObjectLiteralExpression(prop.initializer)) {
+          entries.push([id, prop.initializer]);
+        }
+      }
+    }
+  }
+  return entries;
+};
+
+const findProperty = (
+  obj: ts.ObjectLiteralExpression,
+  key: string,
+): ts.Expression | undefined =>
+  obj.properties.find(
+    (p): p is ts.PropertyAssignment =>
+      ts.isPropertyAssignment(p) && propertyName(p.name) === key,
+  )?.initializer;
+
+/** learnsets.ts → 포켓몬 ID별 Showdown 기술 ID 집합 (learnset이 없는 항목은 제외) */
+export const parseLearnsets = (source: string): Map<string, Set<string>> => {
+  const result = new Map<string, Set<string>>();
+  for (const [speciesId, entry] of topLevelEntries(source)) {
+    const learnset = findProperty(entry, 'learnset');
+    if (!learnset || !ts.isObjectLiteralExpression(learnset)) continue;
+
+    const moves = new Set<string>();
+    for (const prop of learnset.properties) {
+      if (!ts.isPropertyAssignment(prop)) continue;
+      const moveId = propertyName(prop.name);
+      if (moveId) moves.add(moveId);
+    }
+    result.set(speciesId, moves);
+  }
+  return result;
+};
+
+/** pokedex.ts → 포켓몬 ID별 도감번호·이름·기본종·폼 */
+export const parsePokedex = (source: string): Map<string, ShowdownSpecies> => {
+  const result = new Map<string, ShowdownSpecies>();
+  for (const [speciesId, entry] of topLevelEntries(source)) {
+    const num = findProperty(entry, 'num');
+    const name = findProperty(entry, 'name');
+    const baseSpecies = findProperty(entry, 'baseSpecies');
+    const forme = findProperty(entry, 'forme');
+
+    let numValue: number | null = null;
+    if (num && ts.isNumericLiteral(num)) numValue = Number(num.text);
+    if (
+      num &&
+      ts.isPrefixUnaryExpression(num) &&
+      num.operator === ts.SyntaxKind.MinusToken &&
+      ts.isNumericLiteral(num.operand)
+    ) {
+      numValue = -Number(num.operand.text);
+    }
+    if (numValue == null || !name || !ts.isStringLiteralLike(name)) continue;
+
+    result.set(speciesId, {
+      num: numValue,
+      name: name.text,
+      baseSpecies: baseSpecies && ts.isStringLiteralLike(baseSpecies) ? baseSpecies.text : null,
+      forme: forme && ts.isStringLiteralLike(forme) ? forme.text : null,
+    });
+  }
+  return result;
+};
+
+/** Showdown ID 규칙: 소문자, 영숫자만 */
+export const toShowdownId = (value: string): string =>
+  value.toLowerCase().replace(/[^a-z0-9]/g, '');
+
+// ─── DB 상태 ─────────────────────────────────────────────────────
+
+export type DbPoke = {
+  poke_key: string;
+  learnset_owner_key: string | null;
+  dex_number: number | null;
+};
+
+export type DbState = {
+  pokes: DbPoke[];
+  moves: { id: number; identifier: string }[];
+  rows: { id: number; poke_key: string; move_id: number }[];
+};
+
+// ─── 제안 ────────────────────────────────────────────────────────
+
+export type Proposal = {
+  target_table: 'champions_poke_move';
+  op: 'insert' | 'delete';
+  target_key: Record<string, string | number>;
+  field: null;
+  current_value: null;
+  proposed_value: null;
+  payload: Record<string, string | number> | null;
+  source_values: Record<string, unknown>;
+  confidence: 'high' | 'medium' | 'conflict';
+  note: string;
+};
+
+export type BuildResult = {
+  proposals: Proposal[];
+  unmatchedSpecies: string[];
+  unmatchedMoves: string[];
+  ownerConflicts: string[];
+  owners: number;
+  pairs: number;
+};
+
+export const buildProposals = (
+  learnsets: Map<string, Set<string>>,
+  pokedex: Map<string, ShowdownSpecies>,
+  db: DbState,
+): BuildResult => {
+  const proposals: Proposal[] = [];
+  const unmatchedSpecies: string[] = [];
+  const unmatchedMoves = new Set<string>();
+  const ownerConflicts: string[] = [];
+
+  const pokeByKey = new Map(db.pokes.map((p) => [p.poke_key, p]));
+  const pokeBySdId = new Map(db.pokes.map((p) => [toShowdownId(p.poke_key), p]));
+  const moveIdBySdId = new Map(db.moves.map((m) => [toShowdownId(m.identifier), m.id]));
+  const ownerOf = (key: string) => pokeByKey.get(key)?.learnset_owner_key ?? key;
+
+  // 1) Showdown 포켓몬 → DB owner, 같은 owner에 모이는 폼은 learnset이 같아야 한다
+  const desiredByOwner = new Map<string, { moves: Set<string>; from: string[] }>();
+  for (const [sdId, moves] of learnsets) {
+    const dex = pokedex.get(sdId);
+    let poke = pokeBySdId.get(sdId);
+    if (!poke && dex?.forme === 'F' && dex.baseSpecies) {
+      const base = pokeBySdId.get(toShowdownId(dex.baseSpecies));
+      poke = base ? pokeByKey.get(`${base.poke_key}-female`) : undefined;
+    }
+    if (!poke || (dex && poke.dex_number !== dex.num)) {
+      unmatchedSpecies.push(dex ? `${sdId} (No.${dex.num})` : sdId);
+      continue;
+    }
+
+    const owner = ownerOf(poke.poke_key);
+    const existing = desiredByOwner.get(owner);
+    if (!existing) {
+      desiredByOwner.set(owner, { moves, from: [sdId] });
+      continue;
+    }
+    const same =
+      existing.moves.size === moves.size && [...moves].every((m) => existing.moves.has(m));
+    if (!same) ownerConflicts.push(`${owner}: ${[...existing.from, sdId].join(' ≠ ')}`);
+    existing.from.push(sdId);
+  }
+  for (const conflict of ownerConflicts) desiredByOwner.delete(conflict.split(':')[0]);
+
+  // 2) 원하는 (owner, move_id) 집합
+  const desired = new Map<string, { owner: string; moveId: number; sdMove: string; from: string[] }>();
+  for (const [owner, { moves, from }] of desiredByOwner) {
+    for (const sdMove of moves) {
+      const moveId = moveIdBySdId.get(sdMove);
+      if (moveId == null) {
+        unmatchedMoves.add(sdMove);
+        continue;
+      }
+      desired.set(`${owner}|${moveId}`, { owner, moveId, sdMove, from });
+    }
+  }
+
+  // 3) 현재 DB 행 분류
+  const existingOwnerPairs = new Set<string>();
+  const aliasRows: DbState['rows'] = [];
+  const ownerRows: DbState['rows'] = [];
+  for (const row of db.rows) {
+    if (ownerOf(row.poke_key) !== row.poke_key) aliasRows.push(row);
+    else {
+      ownerRows.push(row);
+      existingOwnerPairs.add(`${row.poke_key}|${row.move_id}`);
+    }
+  }
+
+  // 4) 추가
+  for (const [key, { owner, moveId, sdMove, from }] of desired) {
+    if (existingOwnerPairs.has(key)) continue;
+    proposals.push({
+      target_table: 'champions_poke_move',
+      op: 'insert',
+      target_key: { poke_key: owner, move_id: moveId },
+      field: null,
+      current_value: null,
+      proposed_value: null,
+      payload: { poke_key: owner, move_id: moveId },
+      source_values: { showdown_species: from, showdown_move: sdMove },
+      confidence: 'medium',
+      note: 'Showdown Champions learnset',
+    });
+  }
+
+  // 5) 삭제: 매핑이 완전할 때만
+  const mappingComplete = unmatchedSpecies.length === 0 && unmatchedMoves.size === 0;
+  if (mappingComplete) {
+    for (const row of aliasRows) {
+      const owner = ownerOf(row.poke_key);
+      const ownerKey = `${owner}|${row.move_id}`;
+      // owner 행이 이미 있거나 이번에 추가될 때만 high. 아니면 지우면 정보가 사라지므로 conflict
+      const ownerCovered = existingOwnerPairs.has(ownerKey) || desired.has(ownerKey);
+      proposals.push({
+        target_table: 'champions_poke_move',
+        op: 'delete',
+        target_key: { id: row.id },
+        field: null,
+        current_value: null,
+        proposed_value: null,
+        payload: null,
+        source_values: { poke_key: row.poke_key, owner, move_id: row.move_id },
+        confidence: ownerCovered ? 'high' : 'conflict',
+        note: ownerCovered
+          ? `별칭 행 (${row.poke_key} → ${owner} 행으로 해석됨)`
+          : `별칭 행이지만 ${owner}에 같은 기술 행이 없음`,
+      });
+    }
+
+    const ownerDeletes = ownerRows.filter(
+      (row) => !desired.has(`${row.poke_key}|${row.move_id}`) && !ownerConflicts.some((c) => c.startsWith(`${row.poke_key}:`)),
+    );
+    if (ownerDeletes.length > MAX_OWNER_DELETES) {
+      throw new Error(
+        `Showdown 기준으로 지워야 할 기존 행이 ${ownerDeletes.length}개입니다 (한도 ${MAX_OWNER_DELETES}). 데이터 이상이 의심되어 멈춥니다`,
+      );
+    }
+    for (const row of ownerDeletes) {
+      proposals.push({
+        target_table: 'champions_poke_move',
+        op: 'delete',
+        target_key: { id: row.id },
+        field: null,
+        current_value: null,
+        proposed_value: null,
+        payload: null,
+        source_values: { poke_key: row.poke_key, move_id: row.move_id },
+        confidence: 'medium',
+        note: 'Showdown Champions learnset에 없음',
+      });
+    }
+  }
+
+  return {
+    proposals,
+    unmatchedSpecies,
+    unmatchedMoves: [...unmatchedMoves],
+    ownerConflicts,
+    owners: desiredByOwner.size,
+    pairs: desired.size,
+  };
+};
+
+// ─── 실행 ────────────────────────────────────────────────────────
+
+const requireEnv = (key: string): string => {
+  const value = process.env[key];
+  if (!value) {
+    throw new Error(`${key} 환경 변수가 없습니다 (.env.local 확인)`);
+  }
+  return value;
+};
+
+const main = async () => {
+  const sql = postgres({
+    host: requireEnv('INGEST_DB_HOST'),
+    port: 5432,
+    database: 'postgres',
+    username: `ingest_bot.${PROJECT_REF}`,
+    password: requireEnv('INGEST_DB_PASSWORD'),
+    ssl: 'require',
+    max: 1,
+    prepare: false,
+  });
+
+  const [run] = await sql<{ id: number }[]>`
+    insert into ingest.run (source, scope)
+    values ('generator', 'champions-learnset')
+    returning id
+  `;
+  const runId = run.id;
+  const stats: Record<string, unknown> = {};
+
+  try {
+    const snapshots = await sql<{ id: number; page_key: string; content: string }[]>`
+      select distinct on (page_key) id::int, page_key, content
+      from ingest.snapshot
+      where source = 'showdown' and page_key in (${FILE_LEARNSETS}, ${FILE_POKEDEX})
+      order by page_key, fetched_at desc
+    `;
+    const byPath = new Map(snapshots.map((s) => [s.page_key, s]));
+    const learnsetSnap = byPath.get(FILE_LEARNSETS);
+    const pokedexSnap = byPath.get(FILE_POKEDEX);
+    if (!learnsetSnap || !pokedexSnap) {
+      throw new Error('Showdown 스냅샷이 없습니다. fetch-showdown-snapshot을 먼저 실행하세요');
+    }
+    stats.snapshotIds = { learnsets: learnsetSnap.id, pokedex: pokedexSnap.id };
+
+    // bigint 칸은 postgres 라이브러리가 문자열로 돌려주므로 ::int로 바꿔 받는다
+    const [pokes, moves, rows] = await Promise.all([
+      sql<DbPoke[]>`select poke_key, learnset_owner_key, dex_number::int from public.poke`,
+      sql<{ id: number; identifier: string }[]>`select id::int, identifier from public.move`,
+      sql<{ id: number; poke_key: string; move_id: number }[]>`
+        select id::int, poke_key, move_id::int from public.champions_poke_move
+      `,
+    ]);
+
+    const result = buildProposals(
+      parseLearnsets(learnsetSnap.content),
+      parsePokedex(pokedexSnap.content),
+      { pokes, moves, rows },
+    );
+    const { proposals } = result;
+
+    // 나눠서 넣는다. 같은 대상에 pending 제안이 이미 있으면 건너뛴다
+    // 문자열(JSON.stringify)을 넘기면 jsonb로 한 번 더 감싸지므로 배열을 sql.json()으로 넘긴다
+    let inserted = 0;
+    for (let i = 0; i < proposals.length; i += INSERT_BATCH_SIZE) {
+      const batch = proposals.slice(i, i + INSERT_BATCH_SIZE);
+      const res = await sql<{ id: number }[]>`
+        insert into ingest.move_proposal
+          (run_id, target_table, op, target_key, field, current_value,
+           proposed_value, payload, source_values, confidence, note)
+        select ${runId}, r.target_table, r.op, r.target_key, r.field, r.current_value,
+               r.proposed_value, r.payload, r.source_values, r.confidence, r.note
+        from jsonb_to_recordset(${sql.json(batch as unknown as postgres.JSONValue)}::jsonb) as r(
+          target_table text, op text, target_key jsonb, field text,
+          current_value text, proposed_value text, payload jsonb,
+          source_values jsonb, confidence text, note text)
+        -- 같은 대상·같은 값으로 이미 거절된 제안은 다시 만들지 않는다 (값이 바뀌면 새로 올라온다)
+        where not exists (
+          select 1 from ingest.move_proposal x
+          where x.status = 'rejected'
+            and x.target_table = r.target_table and x.op = r.op and x.target_key = r.target_key
+            and coalesce(x.field, '') = coalesce(r.field, '')
+            and x.proposed_value is not distinct from r.proposed_value
+            and x.payload is not distinct from r.payload
+        )
+        on conflict (target_table, op, target_key, (coalesce(field, '')))
+          where status = 'pending'
+        do nothing
+        returning id
+      `;
+      inserted += res.length;
+    }
+
+    const count = (op: string, confidence?: string) =>
+      proposals.filter((p) => p.op === op && (!confidence || p.confidence === confidence)).length;
+    Object.assign(stats, {
+      owners: result.owners,
+      pairs: result.pairs,
+      unmatchedSpecies: result.unmatchedSpecies,
+      unmatchedMoves: result.unmatchedMoves,
+      ownerConflicts: result.ownerConflicts,
+      existingRows: rows.length,
+      proposals: proposals.length,
+      inserted,
+      skippedAsDuplicate: proposals.length - inserted,
+      byKind: {
+        insert: count('insert'),
+        'delete alias (high)': count('delete', 'high'),
+        'delete alias (conflict)': count('delete', 'conflict'),
+        'delete not in showdown': count('delete', 'medium'),
+      },
+    });
+
+    const clean =
+      result.unmatchedSpecies.length === 0 &&
+      result.unmatchedMoves.length === 0 &&
+      result.ownerConflicts.length === 0;
+    const status = clean ? 'success' : 'partial';
+    await sql`
+      update ingest.run
+      set status = ${status}, finished_at = now(), stats = ${sql.json(stats as postgres.JSONValue)}
+      where id = ${runId}
+    `;
+    console.log(`[run ${runId}] ${status}`, JSON.stringify(stats, null, 2));
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    await sql`
+      update ingest.run
+      set status = 'failed', finished_at = now(),
+          stats = ${sql.json(stats as postgres.JSONValue)}, error = ${message}
+      where id = ${runId}
+    `;
+    console.error(`[run ${runId}] failed: ${message}`);
+    process.exitCode = 1;
+  } finally {
+    await sql.end();
+  }
+};
+
+// 테스트에서 import할 때는 실행하지 않는다
+if (import.meta.url === `file://${process.argv[1]}`) {
+  await main();
+}
