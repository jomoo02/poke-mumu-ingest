@@ -0,0 +1,90 @@
+# 매일 새벽 4시(한국 시간) 포켓몬 데이터 수집
+#
+# - ingest_bot(public 읽기 전용)으로만 접속한다. 원문은 ingest.snapshot, 제안은 ingest.move_proposal에만 쓴다.
+# - public 반영은 하지 않는다. 제안은 직접 확인·승인한 뒤 반영한다.
+# - 한국어 효과 문구 제안은 이 워크플로가 끝난 뒤 Claude 예약 작업(04:40)이 만든다.
+# - 수치 이력(--phase=history)은 수치 제안을 반영한 뒤에만 정확하므로 여기서 돌리지 않는다.
+#
+# 필요한 저장소 Secrets: INGEST_DB_HOST, INGEST_DB_PASSWORD
+# 수동 실행: Actions 탭 > ingest-nightly > Run workflow
+
+name: ingest-nightly
+
+on:
+  schedule:
+    - cron: '0 19 * * *' # UTC 19:00 = 한국 시간 04:00
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ingest-nightly
+  cancel-in-progress: false
+
+env:
+  INGEST_DB_HOST: ${{ secrets.INGEST_DB_HOST }}
+  INGEST_DB_PASSWORD: ${{ secrets.INGEST_DB_PASSWORD }}
+
+jobs:
+  bulbapedia:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@v4
+      - uses: pnpm/action-setup@v4
+        with:
+          version: 10
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+          cache: pnpm
+      - run: pnpm install --frozen-lockfile
+
+      # 판 번호만 먼저 묻고, 바뀐 기술 문서만 원문을 받는다
+      - name: 기술 문서 수집 (바뀐 문서만)
+        run: node scripts/ingest/fetch-move-snapshot.mts --changed-only
+
+      # 앞 단계가 실패해도 나머지는 따로 돌린다 (job은 실패로 표시되어 메일이 온다)
+      - name: 사용 가능 표 수집
+        if: ${{ !cancelled() }}
+        run: node scripts/ingest/fetch-availability-snapshot.mts
+
+      - name: 기술 수치 제안
+        if: ${{ !cancelled() }}
+        run: node scripts/ingest/generate-bulbapedia-move-proposals.mts --phase=values
+
+      - name: 사용 가능 여부 제안
+        if: ${{ !cancelled() }}
+        run: node scripts/ingest/generate-availability-proposals.mts
+
+  showdown:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v4
+      - uses: pnpm/action-setup@v4
+        with:
+          version: 10
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+          cache: pnpm
+      - run: pnpm install --frozen-lockfile
+
+      - name: Showdown 수집
+        run: node scripts/ingest/fetch-showdown-snapshot.mts
+
+      # Champions 업데이트로 기록이 필요한 변경이 생기면 --champions-version 없이는 실패한다.
+      # 그때는 버전을 확인해 수동으로 다시 실행한다.
+      - name: Champions 기술 제안
+        if: ${{ !cancelled() }}
+        run: node scripts/ingest/generate-champions-move-proposals.mts
+
+      - name: Champions 배우는 기술 제안
+        if: ${{ !cancelled() }}
+        run: node scripts/ingest/generate-champions-learnset-proposals.mts
+
+      - name: 기술 메타 제안
+        if: ${{ !cancelled() }}
+        run: node scripts/ingest/generate-showdown-meta-proposals.mts
